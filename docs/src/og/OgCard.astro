---
// The social card (public/og.png, 1200 × 630): the home page's first screen in one frame, in the dark theme. The title
// and lede are the home page's hero fields; under them runs the hero's map, held where the pool runs its jobs; the
// rails are the page margin's sprocket holes. Served only by `astro dev`, at /og-card/ (astro.config.mjs); `pnpm og`
// screenshots it into public/og.png.
import { getEntry } from 'astro:content';
import '../styles/tokens.css';
import '../lib/heromap/map.css';
import logo from '../assets/logo-dark.svg';
import { stillMap } from '../lib/heromap/still.ts';

const home = await getEntry('docs', 'index');
const { title = '', tagline = '' } = home?.data.hero ?? {};
// The title names the map's two parts in their colours, as the hero's h1 does (Story.astro).
const heading = title
	.replace('Worker pools', '<span class="pools">Worker pools</span>')
	.replace('job queues', '<span class="queues">job queues</span>');
const still = stillMap();
const fonts =
	'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500;700&display=block';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>VarMQ social card</title>
		<link rel="stylesheet" href={fonts} />
	</head>
	<body>
		<div class="rail rail--l" aria-hidden="true"></div>
		<div class="rail rail--r" aria-hidden="true"></div>
		<main class="card">
			<header class="top">
				<img class="logo" src={logo.src} alt="VarMQ" width="157" height="40" />
				<p class="install"><span class="prompt">$</span> go get github.com/goptics/varmq</p>
			</header>
			<h1 set:html={heading} />
			<p class="lede" set:html={tagline} />
			<div class="map" aria-hidden="true">
				<varmq-map style={still.style} set:html={still.html} />
			</div>
			<p class="url">varmq.goptics.org</p>
		</main>
		<script>
			// The live map (story/map.ts), held at one moment of its loop: ?at=<chapter>:<ms into it>. By default, the
			// pool's chapter as jobs wait in the queue, one passes the event loop and the goroutines run others.
			import { mountMap } from '../lib/story/map.ts';
			import { starts } from '../lib/heromap/chapters.ts';

			const [n, ms] = (new URLSearchParams(location.search).get('at') ?? '2:3400').split(':').map(Number);
			mountMap(document.querySelector<HTMLElement>('varmq-map')!, () => {}).seek(starts()[n - 1] + ms);
		</script>
	</body>
</html>

<style is:global>
	/* The screenshot is of the page alone: dev's toolbar stays out of it. */
	astro-dev-toolbar {
		display: none !important;
	}

	html,
	body {
		margin: 0;
		width: 1200px;
		height: 630px;
		overflow: hidden;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--display);
	}

	/* The page margin's rails: a hole every 48 px, the dashed edge of the sheet inside them (story.css, .roll). */
	.rail {
		--hole: oklch(from var(--paper) calc(l * 0.78) calc(c * 0.78) h);
		--rim: color-mix(in srgb, var(--brand) 35%, transparent);
		position: absolute;
		top: 0;
		bottom: 0;
		width: 40px;
		background: radial-gradient(circle at 50% 50%, var(--hole) 0 4.5px, var(--rim) 5px 5.75px, transparent 6.25px) 0 15px /
			100% 48px repeat-y;
	}

	.rail--l {
		left: 0;
		border-right: 1px dashed var(--rule);
	}

	.rail--r {
		right: 0;
		border-left: 1px dashed var(--rule);
	}

	.card {
		position: absolute;
		inset: 0 41px;
		display: flex;
		flex-direction: column;
		padding: 52px 56px 0;
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		height: 40px;
		width: auto;
	}

	.install {
		margin: 0;
		padding: 12px 16px;
		border: 1px solid var(--panel-rule);
		border-radius: 12px;
		background: var(--panel);
		color: var(--panel-ink);
		font: 400 1rem/1 var(--mono);
	}

	.prompt {
		color: var(--panel-ink-2);
	}

	h1 {
		margin: 44px 0 0;
		font-size: 4.5rem;
		font-weight: 700;
		font-variation-settings: 'opsz' 96;
		letter-spacing: -0.035em;
		line-height: 0.98;
		white-space: nowrap;
	}

	h1 .pools {
		color: var(--vm-go);
	}

	h1 .queues {
		color: var(--vm-job-edge);
	}

	.lede {
		margin: 20px 0 0;
		max-width: 56ch;
		color: var(--ink-2);
		font-size: 1.375rem;
		line-height: 1.4;
	}

	/* The hero's map along the foot of the card: the pool's chapter is wide and short, so the square is sized for the
	   band's width and the band crops it above and below; its ends fade into the paper. */
	.map {
		position: relative;
		flex: 1;
		margin-inline: -56px;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.map varmq-map {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 1000px;
		aspect-ratio: 1;
		translate: -50% -47%;
	}

	.url {
		position: absolute;
		right: 28px;
		bottom: 24px;
		margin: 0;
		color: var(--ink-3);
		font: 500 1rem/1 var(--mono);
		letter-spacing: 0.02em;
	}
</style>

---
// Every docs page: the Fumadocs layout (a React island) around the page, which Astro renders, so the scenes in it and
// their scripts are plain Astro components. Their HTML reaches the island as a slot, which React never re-renders.
import { execFileSync } from 'node:child_process';
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import CodeFrame from '../components/ui/CodeFrame.astro';
import PageTitle from '../components/shell/PageTitle.astro';
import Footer from '../components/shell/Footer.astro';
import Pagination from '../components/shell/Pagination.astro';
import { Docs } from '../components/fd/docs';
import { mdxComponents } from '../components/fd/mdx';
import { pagePaths, sidebarTree, source } from '../lib/source';
import logoDark from '../assets/logo-dark.svg?url';
import logoLight from '../assets/logo-light.svg?url';

export const getStaticPaths = pagePaths satisfies GetStaticPaths;

const { page } = Astro.props;
const { body: Content, toc } = await page.data.load();
const tree = await source.serializePageTree(sidebarTree(page.url));

const file = `src/content/docs/${page.path}`;
const editUrl = `https://github.com/goptics/varmq/edit/main/docs/${file}`;
// The last commit that touched the page. CI checks out the full history for this (.github/workflows/docs.yml).
let updated: Date | undefined;
try {
	const iso = execFileSync('git', ['log', '-1', '--format=%cI', '--', file], { encoding: 'utf8' }).trim();
	if (iso) updated = new Date(iso);
} catch {}
---

<Base title={page.data.title} description={page.data.description}>
	<Docs client:load pathname={Astro.url.pathname} params={Astro.params} tree={tree} toc={toc} logo={{ light: logoLight, dark: logoDark }}>
		<PageTitle url={page.url} title={page.data.title} />
		<div class="prose doc-body">
			<Content components={{ ...mdxComponents, pre: CodeFrame }} />
		</div>
		<div class="shell-meta not-prose">
			<a href={editUrl}>Edit page</a>
			{
				updated && (
					<p>
						Last updated: <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en', { dateStyle: 'medium' })}</time>
					</p>
				)
			}
		</div>
		<Pagination url={page.url} />
		<Footer />
	</Docs>
</Base>

<script>
	// The sidebar's sliding highlight (fd-theme.css). It is the sidebar's ::before, so React's markup is never touched.
	const rows = 'a[data-active], button:has(> .fd-page-tree-item-name)';
	addEventListener('pointerover', (event) => {
		const sidebar = document.getElementById('nd-sidebar');
		if (!sidebar || event.pointerType !== 'mouse') return;
		const row = sidebar.contains(event.target as Node) ? (event.target as Element).closest(rows) : null;
		if (!row) return void delete sidebar.dataset.hoverRow;
		const box = sidebar.getBoundingClientRect();
		const { left, top, width, height } = row.getBoundingClientRect();
		sidebar.style.setProperty('--row-x', `${left - box.left}px`);
		sidebar.style.setProperty('--row-y', `${top - box.top}px`);
		sidebar.style.setProperty('--row-w', `${width}px`);
		sidebar.style.setProperty('--row-h', `${height}px`);
		// Off, it takes its place at once; on, the read below commits that, so it fades in there and slides from then on.
		void sidebar.offsetWidth;
		sidebar.dataset.hoverRow = '';
	});
	// The sidebar meets the window's edge, so the mouse can leave it for no element at all.
	document.documentElement.addEventListener('pointerleave', () => delete document.getElementById('nd-sidebar')?.dataset.hoverRow);
</script>

---
import '../../styles/ui.css';
import '../../styles/alt.css';
import logoLight from '../../assets/logo-light.svg';
import logoDark from '../../assets/logo-dark.svg';
import Install from '../../components/ui/Install.astro';
import Pool from '../../components/alt/Pool.astro';
import Scenes from '../../components/alt/Scenes.astro';
import Storage from '../../components/alt/Storage.astro';
import Race from '../../components/alt/Race.astro';
import Examples from '../../components/alt/Examples.astro';
import StatusBar from '../../components/alt/StatusBar.astro';
import ThemeSwitch from '../../components/ui/ThemeSwitch.astro';

const title = 'VarMQ | Queues and worker pools for Go';
const description =
	'A simplest in-memory and distributed storage-agnostic message queue for your concurrent Go program. Typed jobs, priority queues, topics, and Redis or SQLite when jobs must survive a restart.';

const index = [
	{ n: '01', t: 'Start', d: 'Install varmq and run your first worker.', href: '/start/introduction/' },
	{ n: '02', t: 'Concepts', d: 'Workers, queues, jobs and the lifecycle.', href: '/concepts/workers-and-queues/' },
	{ n: '03', t: 'Guides', d: 'Concurrency, errors, waiting, metrics and more.', href: '/guides/queues/' },
	{ n: '04', t: 'Persistence', d: 'Redis and SQLite adapters, and writing your own.', href: '/persistence/overview/' },
	{ n: '05', t: 'Operations', d: 'Control a running worker over HTTP. Export Prometheus metrics.', href: '/operations/rest-api/' },
	{ n: '06', t: 'Comparison', d: 'Features side by side with other Go worker pools.', href: '/reference/comparison/' },
	{ n: '07', t: 'API reference', d: 'Every type and function, on pkg.go.dev.', href: 'https://pkg.go.dev/github.com/goptics/varmq' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// The theme before the first paint: the stored choice (shared with the docs pages), else the system's.
			document.documentElement.dataset.theme = (function () {
				try {
					var t = localStorage.getItem('starlight-theme');
					if (t === 'light' || t === 'dark') return t;
				} catch (e) {}
				return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
			})();
		</script>
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
		/>
	</head>
	<body class="alt">
		<a class="skip" href="#main">Skip to content</a>
		<div class="roll roll--l" aria-hidden="true"></div>
		<div class="roll roll--r" aria-hidden="true"></div>

		<header class="nav">
			<div class="wrap nav__in">
				<a class="nav__logo" href="/alt/" aria-label="VarMQ home">
					<img class="logo--light" src={logoLight.src} alt="VarMQ" width="116" height="30" />
					<img class="logo--dark" src={logoDark.src} alt="VarMQ" width="116" height="30" />
				</a>
				<nav class="nav__links" aria-label="Main">
					<a href="/start/introduction/">Docs</a>
					<a class="opt" href="/guides/queues/">Guides</a>
					<a class="opt" href="#benchmarks">Benchmarks</a>
					<a class="opt" href="https://github.com/goptics/varmq">GitHub</a>
				</nav>
				<ThemeSwitch />
			</div>
		</header>

		<main id="main" tabindex="-1">
			<section class="hero wrap" aria-labelledby="hero-title">
				<div class="banner">
					<span class="banner__id">JOB 01</span><span>VarMQ</span><span class="banner__rule"></span><span class="banner__meta">queue + worker pool</span>
				</div>
				<div class="hero__copy">
					<h1 class="h-display h1" id="hero-title">A queue and <span class="hl">worker pool</span> for concurrent Go.</h1>
					<div class="hero__cols">
						<div class="hero__col">
							<p class="lede">
								Add jobs to a queue. A pool of workers runs them. Keep the jobs in memory, or in Redis or SQLite so they survive a restart.
							</p>
							<p class="proof">
								<span>MIT license</span><span>Go 1.24 and later</span><span>Typed jobs, with generics</span>
								<span><a href="#benchmarks">Benchmarks with raw output</a></span>
							</p>
						</div>
						<div class="hero__col">
							<Install id="hero" />
							<div class="hero__actions">
								<a class="btn btn--primary" href="/start/quick-start/">Quick start</a>
								<a class="btn btn--ghost" href="https://github.com/goptics/varmq">GitHub</a>
							</div>
						</div>
					</div>
				</div>
				<div class="pool-wrap">
					<Pool />
				</div>
			</section>

			<section class="section wrap" aria-labelledby="sched-title">
				<div class="banner">
					<span class="banner__id">JOB 02</span><span>Scheduling</span><span class="banner__rule"></span>
					<button type="button" class="pbtn pbtn--paper" data-scenes-toggle>Pause animation</button>
				</div>
				<div class="section__head">
					<h2 class="h2" id="sched-title">Order, fairness and fan-out, each in one line.</h2>
					<p>
						Every scene runs the real model with the call that makes it. Typed results and errors, job IDs and deduplication,
						context cancellation, metrics, a REST API and Prometheus are in the <a href="/guides/queues/">guides</a>.
					</p>
				</div>
				<Scenes />
			</section>

			<section class="section wrap" aria-labelledby="store-title" style="padding-top:0">
				<div class="banner">
					<span class="banner__id">JOB 03</span><span>Where jobs live</span><span class="banner__rule"></span><span class="banner__meta">same worker, three homes</span>
				</div>
				<div class="section__head">
					<h2 class="h2" id="store-title">Same worker. You choose where the jobs live.</h2>
					<p>
						Press Restart process. A queue in memory ends with the process. A queue in Redis or SQLite keeps the waiting jobs.
					</p>
				</div>
				<Storage />
			</section>

			<Race />

			<section class="section wrap" aria-labelledby="ex-title">
				<div class="banner">
					<span class="banner__id">JOB 05</span><span>Programs</span><span class="banner__rule"></span><span class="banner__meta">each one runs as it is</span>
				</div>
				<div class="section__head">
					<h2 class="h2" id="ex-title">Each tab is a full program.</h2>
					<p>Copy it into a <code class="mono">main.go</code>, or run it in the Go Playground from the docs page.</p>
				</div>
				<Examples />
			</section>

			<section class="section wrap" aria-labelledby="next-title" style="padding-top:0">
				<div class="banner">
					<span class="banner__id">JOB 06</span><span>Index</span><span class="banner__rule"></span><span class="banner__meta">where to read next</span>
				</div>
				<h2 class="sr-only" id="next-title">Where to read next</h2>
				<ul class="index">
					{
						index.map((i) => (
							<li>
								<a href={i.href}>
									<span class="index__n">{i.n}</span>
									<span class="index__t">{i.t}</span>
									<span class="index__d">{i.d}</span>
									<span class="index__go" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section wrap" aria-labelledby="close-title" style="padding-top:0">
				<p class="tear" aria-hidden="true">tear here</p>
				<div class="close">
					<h2 class="h-display h1" id="close-title" style="font-size:clamp(2.25rem,6vw,4.5rem)">Run your first worker.</h2>
					<Install id="close" />
					<div class="hero__actions">
						<a class="btn btn--primary" href="/start/quick-start/">Quick start</a>
						<a class="btn btn--ghost" href="/start/introduction/">Read the docs</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot__in">
				<ul>
					<li><a href="/start/introduction/">Docs</a></li>
					<li><a href="https://pkg.go.dev/github.com/goptics/varmq">API reference</a></li>
					<li><a href="https://benchmarks.goptics.org">Benchmarks</a></li>
					<li><a href="https://github.com/goptics/varmq/blob/main/CHANGELOG.md">Changelog</a></li>
					<li><a href="https://github.com/goptics/varmq">GitHub</a></li>
				</ul>
				<p>VarMQ is MIT licensed. Benchmark figures come from github.com/goptics/benchmarks.</p>
			</div>
		</footer>

		<StatusBar />
		<p class="sr-only" role="status" id="live"></p>

		<script>
			import '../../components/alt/ui.ts';
			import '../../components/alt/pool.ts';
			import '../../components/alt/scenes.ts';
			import '../../components/alt/store.ts';
			import '../../components/alt/race.ts';
		</script>
	</body>
</html>

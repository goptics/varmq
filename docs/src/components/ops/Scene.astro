---
// The frame of every ops scene: a dark panel with a caption line that shows the Go call, a body,
// and a control bar. The text alternative is read through aria-describedby.
import '../../styles/ops.css';

interface Props {
	id: string;
	label: string;
	call: string;
	alt: string;
	class?: string;
}

const { id, label, call, alt, class: cls = '' } = Astro.props;
---

<figure class:list={['ops', 'ops-scene', 'not-content', cls]} role="group" aria-labelledby={`${id}-t`} aria-describedby={`${id}-d`}>
	<div class="ops-frame">
		<div class="ops-frame__cap">
			<span class="ops-frame__tag" id={`${id}-t`}>{label}</span>
			<code class="ops-frame__call" data-call>{call}</code>
		</div>
		<div class="ops-frame__body"><slot /></div>
		<div class="ops-frame__bar"><slot name="controls" /></div>
	</div>
	<p class="ops-sr" id={`${id}-d`}>{alt}</p>
</figure>

---
// A link card for one of the places jobs live, its title led by the store's icon: a memory stick for varmq's own
// in-memory queues, and SQLite's and Redis's logos as the map draws them (lib/heromap/render.ts), in the map's colours
// (styles/story.css).
import { LinkCard } from '@astrojs/starlight/components';
import { LOGOS } from '../lib/heromap/render.ts';

interface Props {
	store: 'memory' | 'redis' | 'sqlite';
	title: string;
	description: string;
	href: string;
}

const { store, title, ...card } = Astro.props;
// A memory stick on the logos' 24-unit grid: its board with three chips, and the contacts under it, split by the key.
const MEMORY =
	'M3 4.5h18A1.5 1.5 0 0 1 22.5 6v8.5A1.5 1.5 0 0 1 21 16H3a1.5 1.5 0 0 1-1.5-1.5V6A1.5 1.5 0 0 1 3 4.5ZM4.5 7v6h4V7Zm5.5 0v6h4V7Zm5.5 0v6h4V7ZM3 17.5h3v2.5H3Zm4.5 0h3v2.5h-3Zm6 0h3v2.5h-3Zm4.5 0h3v2.5h-3Z';
const path = store === 'memory' ? `<path fill-rule="evenodd" d="${MEMORY}"/>` : `<path d="${LOGOS[store === 'redis' ? 'r-store' : 's-store'].d}"/>`;
const icon = `<svg class="store-icon store-icon--${store}" viewBox="0 0 24 24" aria-hidden="true">${path}</svg>`;
---

<LinkCard title={icon + title} {...card} />

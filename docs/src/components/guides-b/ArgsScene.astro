---
import '../../styles/guides-b.css';
import Scene from '../ui/Scene.astro';
import CallStrip from './CallStrip.astro';

const program = 'worker := varmq.NewErrWorker(send)';
const hint = '// reorder the arguments: the last one that sets a value wins';

const describe = `A list of arguments for NewErrWorker. Tick one to include it, and move it up or down. The worker applies them from left to right on top of the defaults, so the last one that sets the concurrency or the name wins. An int64 sets nothing and raises no error. A concurrency below 1 means one per CPU.`;
---

<Scene id="gb-args" title="Argument order" describe={describe} class="gb">
	<div class="gb-cfg">
		<div>
			<span class="slabel">Arguments after the function</span>
			<ol class="gb-args" data-args></ol>
		</div>
		<div>
			<span class="slabel">Read from left to right</span>
			<ol class="gb-trace" data-trace></ol>
			<dl class="gb-res gb-res--after" data-res></dl>
		</div>
	</div>

	<Fragment slot="call">
		<CallStrip program={program} hint={hint} />
	</Fragment>

	<Fragment slot="controls">
		<button type="button" class="pbtn" data-act="reset">Reset order</button>
	</Fragment>
</Scene>

<script>
	import './args.ts';
</script>

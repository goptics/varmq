---
import '../../styles/guides-b.css';
import Scene from '../ui/Scene.astro';
import CallStrip from './CallStrip.astro';
import LoopButtons from './LoopButtons.astro';

const program = `ctx, cancel := context.WithCancel(context.Background())
defer cancel()

worker := varmq.NewWorker(process, 2, varmq.WithContext(ctx))`;
const hint = '// press cancel(): the worker follows, and the call it makes shows here';

const describe = `A simulation of a worker with a limit of 2 and jobs that run for 4 seconds. Five jobs start in the queue. When the context is done, by cancel() or by the deadline, the worker becomes Stopping. The jobs that run keep running until their function returns, unless the function watches the worker's Context().Done() and returns early. The jobs that wait never start. They stay queued, counted by NumPending, and Add still returns true. Nothing reaches Errs(). Start and Restart on a worker with a done context return nil, and the worker stops again at once. After Stop, Restart works.`;
---

<Scene id="gb-context" title="Cancel a worker" describe={describe} class="gb">
	<dl class="sframe__stats" slot="stats">
		<div><dt>Status</dt><dd data-stat="status">Running</dd></div>
		<div><dt>NumProcessing</dt><dd data-stat="processing">0</dd></div>
		<div><dt>NumPending</dt><dd data-stat="pending">0</dd></div>
		<div><dt>queue.Len()</dt><dd data-stat="len">0</dd></div>
	</dl>

	<div aria-hidden="true">
		<div data-pool></div>
	</div>
	<dl class="gb-kv">
		<div><dt>Context().Err()</dt><dd data-kv="err">nil</dd></div>
		<div><dt>Errs()</dt><dd data-kv="errs">empty</dd></div>
		<div><dt>last queue.Add</dt><dd data-kv="add">true</dd></div>
		<div data-deadline hidden><dt>deadline</dt><dd data-kv="deadline">in 6.0 s</dd></div>
	</dl>

	<Fragment slot="call">
		<CallStrip program={program} hint={hint} />
	</Fragment>

	<Fragment slot="controls">
		<div class="seg" role="radiogroup" aria-label="How the context is made" data-made>
			<button type="button" role="radio" aria-checked="true" tabindex="0" data-key="cancel">WithCancel</button>
			<button type="button" role="radio" aria-checked="false" tabindex="-1" data-key="timeout">WithTimeout(6s)</button>
		</div>
		<button type="button" class="pbtn" data-act="watch" aria-pressed="false">Function watches Done(): off</button>
		<span class="gb-break"></span>
		<button type="button" class="pbtn pbtn--primary" data-act="cancel">cancel()</button>
		<button type="button" class="pbtn" data-act="stop">worker.Stop()</button>
		<button type="button" class="pbtn" data-act="start">worker.Start()</button>
		<button type="button" class="pbtn" data-act="restart">worker.Restart()</button>
		<button type="button" class="pbtn" data-act="add">queue.Add()</button>
		<button type="button" class="pbtn" data-act="reset">Reset</button>
		<LoopButtons />
	</Fragment>

	<p class="sframe__note" slot="note">
		The worker has a limit of 2 and each job runs for 4 s. Five jobs start in the queue.
	</p>
</Scene>

<script>
	import './context.ts';
</script>

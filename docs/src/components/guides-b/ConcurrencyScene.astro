---
import '../../styles/guides-b.css';
import Scene from '../ui/Scene.astro';
import CallStrip from './CallStrip.astro';
import LoopButtons from './LoopButtons.astro';

const program = `worker := varmq.NewWorker(process, 3)
queue := worker.BindQueue()`;
const hint = '// move the slider: TunePool(n) runs and its result shows here';

const describe = `A simulation of one worker. Each job takes 2.4 seconds. The slider calls TunePool on the running worker. Each block is a live goroutine: a busy one fills while it runs a job and shows +n for the jobs it still holds as a batch, an idle one waits in the pool, and one that runs above a lowered limit has an amber edge. A goroutine that exits disappears. The meter compares the jobs that finish each second with the ceiling, which is the limit divided by 2.4 s, and with the jobs that arrive. With a limit of 1 the one goroutine takes the waiting jobs as a batch, and raising the limit does not spread that batch.`;
---

<Scene id="gb-concurrency" title="Worker pool" describe={describe} class="gb">
	<dl class="sframe__stats" slot="stats">
		<div><dt>NumConcurrency</dt><dd data-stat="limit">3</dd></div>
		<div><dt>NumProcessing</dt><dd data-stat="processing">0</dd></div>
		<div><dt>NumPending</dt><dd data-stat="pending">0</dd></div>
		<div><dt>NumIdleWorkers</dt><dd data-stat="idle">1</dd></div>
	</dl>

	<div aria-hidden="true">
		<div data-pool></div>
		<div class="gb-meter">
			<span class="slabel">throughput</span>
			<div class="gb-meter__track">
				<span class="gb-meter__fill" data-fill></span>
				<span class="gb-meter__tick" data-tick-cap></span>
				<span class="gb-meter__tick gb-meter__tick--arr" data-tick-arr></span>
			</div>
			<p class="gb-meter__text" data-meter-text></p>
		</div>
	</div>

	<Fragment slot="call">
		<CallStrip program={program} hint={hint} />
	</Fragment>

	<Fragment slot="controls">
		<label class="sfield">
			limit
			<input type="range" min="1" max="12" value="3" data-limit aria-describedby="gb-concurrency-d" />
			<output data-limit-out>3</output>
		</label>
		<button type="button" class="pbtn pbtn--primary" data-act="add3">Add 3 jobs</button>
		<button type="button" class="pbtn" data-act="add12">Add 12 jobs</button>
		<button type="button" class="pbtn" data-act="same">TunePool(same)</button>
		<button type="button" class="pbtn" data-act="producer" aria-pressed="true">Producer: on</button>
		<LoopButtons />
	</Fragment>

	<p class="sframe__note" slot="note">
		Each job takes 2.4 s. A block is a live goroutine: it fills while it runs a job, +n is the rest of its
		batch, and an amber edge means it runs above the limit. The meter compares the jobs done each second with the ceiling, the limit divided
		by 2.4 s, and with the jobs that arrive.
	</p>
</Scene>

<script>
	import './concurrency.ts';
</script>

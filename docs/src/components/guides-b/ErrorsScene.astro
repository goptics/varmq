---
import '../../styles/guides-b.css';
import Scene from '../ui/Scene.astro';
import CallStrip from './CallStrip.astro';
import LoopButtons from './LoopButtons.astro';

const program = `worker := varmq.NewErrWorker(process, "mailer")`;
const hint = '// add a job: the call it makes and what it returns show here';

const describe = `A simulation of a worker named mailer with a limit of 2. Pick a worker type and what its function does, then add jobs. A failure is reported in up to three places. The job handle of an error or result worker gets the error. A plain worker has no handle. The Errs() channel has room for one error, so when it is full the next error is dropped and counted. The error handler runs for every failure, including the dropped ones. A result worker returns the zero result when the function fails, even if the function also returned a value. The counters at the top are the four counters of Metrics().`;
---

<Scene id="gb-errors" title="Where a failure goes" describe={describe} class="gb">
	<dl class="sframe__stats" slot="stats">
		<div><dt>Submitted</dt><dd data-stat="submitted">0</dd></div>
		<div><dt>Completed</dt><dd data-stat="completed">0</dd></div>
		<div><dt>Successful</dt><dd data-stat="successful">0</dd></div>
		<div><dt>Failed</dt><dd data-stat="failed">0</dd></div>
	</dl>

	<div class="gb-boxes">
		<section class="gb-box" aria-labelledby="gb-err-h1">
			<p class="slabel" id="gb-err-h1">Job handle <b data-handle-name>Err()</b></p>
			<ul class="gb-list" data-handles></ul>
		</section>
		<section class="gb-box" aria-labelledby="gb-err-h2">
			<p class="slabel" id="gb-err-h2">Errs() channel <b>room for 1</b></p>
			<p class="gb-slot" data-slot>empty</p>
			<p class="gb-drops" data-drops>dropped: 0</p>
			<p class="gb-note-line" data-reader-note>Nothing reads the channel.</p>
		</section>
		<section class="gb-box" aria-labelledby="gb-err-h3">
			<p class="slabel" id="gb-err-h3">WithErrHandler <b>every failure</b></p>
			<ul class="gb-list" data-handler></ul>
		</section>
	</div>

	<Fragment slot="call">
		<CallStrip program={program} hint={hint} />
	</Fragment>

	<Fragment slot="controls">
		<div class="seg" role="radiogroup" aria-label="Worker type" data-type>
			<button type="button" role="radio" aria-checked="false" tabindex="-1" data-key="plain">NewWorker</button>
			<button type="button" role="radio" aria-checked="true" tabindex="0" data-key="err">NewErrWorker</button>
			<button type="button" role="radio" aria-checked="false" tabindex="-1" data-key="result">NewResultWorker</button>
		</div>
		<div class="seg" role="radiogroup" aria-label="What the function does" data-outcome>
			<button type="button" role="radio" aria-checked="false" tabindex="-1" data-key="ok">returns</button>
			<button type="button" role="radio" aria-checked="true" tabindex="0" data-key="error">fails</button>
			<button type="button" role="radio" aria-checked="false" tabindex="-1" data-key="panic">panics</button>
		</div>
		<button type="button" class="pbtn pbtn--primary" data-act="add">Add job</button>
		<button type="button" class="pbtn" data-act="add3">Add 3 jobs</button>
		<button type="button" class="pbtn" data-act="read">Read Errs()</button>
		<button type="button" class="pbtn" data-act="reader" aria-pressed="false">Reader goroutine: off</button>
		<LoopButtons />
	</Fragment>

	<p class="sframe__note" slot="note">
		The worker is named mailer and has a limit of 2. The counters at the top are the four counters of <code>Metrics()</code>.
	</p>
</Scene>

<script>
	import './errors.ts';
</script>

---
import SceneFrame from './SceneFrame.astro';

const code = `worker := varmq.NewErrWorker(process, 2)
queue := worker.BindQueue()
m := worker.Metrics()`;
---

<SceneFrame scene="metrics" title="Metrics()" code={code} hint="// add jobs, pause, purge or reset: the counters move, and the call shows here">
	<Fragment slot="stats">
		<div><dt>Status</dt><dd data-stat="status">Idle</dd></div>
		<div><dt>NumPending</dt><dd data-stat="pending">0</dd></div>
		<div><dt>NumProcessing</dt><dd data-stat="processing">0</dd></div>
	</Fragment>

	<div aria-hidden="true">
		<div data-pool></div>
	</div>
	<dl class="gb-kv">
		<div><dt>m.Submitted()</dt><dd data-kv="submitted">0</dd></div>
		<div><dt>m.Completed()</dt><dd data-kv="completed">0</dd></div>
		<div><dt>m.Successful()</dt><dd data-kv="successful">0</dd></div>
		<div><dt>m.Failed()</dt><dd data-kv="failed">0</dd></div>
	</dl>
	<div class="gb-eq">
		<div class="gb-eq__line">Submitted() == NumPending() + NumProcessing() + Completed()</div>
		<div class="gb-eq__calc">
			<span data-calc>0 == 0 + 0 + 0</span>
			<span class="gb-tag" data-tag>holds</span>
		</div>
		<p class="gb-eq__why" data-why>The equation is for a worker with nothing running.</p>
	</div>

	<Fragment slot="controls">
		<button type="button" class="gb-btn gb-btn--primary" data-act="add">Add job</button>
		<button type="button" class="gb-btn" data-act="fail">Add job that fails</button>
		<button type="button" class="gb-btn" data-act="add5">Add 5</button>
		<button type="button" class="gb-btn" data-act="pause-toggle">Pause()</button>
		<button type="button" class="gb-btn" data-act="purge">Purge()</button>
		<button type="button" class="gb-btn" data-act="reset-metrics">Reset()</button>
		<div class="gb-seg" role="radiogroup" aria-label="Concurrency" data-limit>
			<button type="button" class="gb-btn" role="radio" aria-checked="false" tabindex="-1" data-value="1">limit 1</button>
			<button type="button" class="gb-btn" role="radio" aria-checked="true" tabindex="0" data-value="2">limit 2</button>
		</div>
	</Fragment>

	<Fragment slot="alt">
		A simulation of one error worker. Each job takes 2.2 seconds. The four counters of <code>Metrics()</code> move as
		jobs run: <code>Submitted</code> counts each job the queue accepted, <code>Completed</code> counts each job that ran,
		and <code>Successful</code> and <code>Failed</code> split those. The line below them checks <code>Submitted ==
		NumPending + NumProcessing + Completed</code>. It holds on an idle or paused worker. It does not hold after
		<code>Purge</code>, after <code>Reset</code> in the middle of a run, or at limit 1 while a goroutine works through a
		batch. The scene says which case it is.
	</Fragment>
</SceneFrame>

<script>
	import './metrics.ts';
</script>

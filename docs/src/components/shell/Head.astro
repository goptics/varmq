---
import Default from '@astrojs/starlight/components/Head.astro';
import logoDark from '../../assets/logo-dark.svg';
import logoLight from '../../assets/logo-light.svg';

// The fonts load without blocking the first paint: the stylesheet applies once it arrives, and display=swap shows the fallback until then.
const fonts =
	'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500;700&display=swap';

// The header logo (astro.config.mjs, logo) is fetched early, so it paints with the header text. The theme shows one of
// the two, but both images load either way.
const logos = [logoLight.src, logoDark.src];

// Starlight gives the home page the route id ''.
const home = Astro.locals.starlightRoute.id === '';
---

<Default {...Astro.props}><slot /></Default>
{
	// The home page's own rules (story.css) key on this as well as on :has(.st), so they apply from the first paint, before
	// the parser reaches the story; without JS the :has() alone applies them a moment later.
	home && <script is:inline>document.documentElement.dataset.home = '';</script>
}
{logos.map((href) => <link rel="preload" as="image" type="image/svg+xml" href={href} />)}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href={fonts} />
<link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fonts} /></noscript>
{
	// Without JS the home page's tour cannot start, so its button is hidden.
	home && (
		<noscript>
			<style is:inline>.st-tour { display: none !important; }</style>
		</noscript>
	)
}

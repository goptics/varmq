---
// The hero slot. The home page opens on the story (Story.astro). Starlight also draws the 404 page with the hero,
// which keeps its banner and Starlight's own hero.
import Default from '@astrojs/starlight/components/Hero.astro';
import Story from '../Story.astro';

const { id } = Astro.locals.starlightRoute.entry;
const notFound = id === '404' || id.endsWith('/404');
---

{
	notFound ? (
		<>
			<p class="shell-banner">
				<span class="shell-banner__id">JOB 404</span>
				<span class="shell-banner__label">Not found</span>
				<span class="shell-banner__rule" aria-hidden="true" />
			</p>
			<Default {...Astro.props}>
				<slot />
			</Default>
		</>
	) : (
		<>
			<div class="roll roll--l" aria-hidden="true" />
			<div class="roll roll--r" aria-hidden="true" />
			<Story />
		</>
	)
}

<script>
	// The sprocket holes move with the scroll (story.css, .roll): the left rail's down, the right rail's up, by as
	// much as the page moved, and the glow from the top of the page to the bottom. Each frame eases them a share of
	// the way to the scroll position, so they glide after a step's snap instead of jumping. Reduced motion keeps
	// them still and unlit.
	const left = document.querySelector<HTMLElement>('.roll--l');
	const right = document.querySelector<HTMLElement>('.roll--r');
	if (left && right && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const EASE = 0.12; // the share of the remaining distance covered each frame
		let y = scrollY;
		let frame = 0;
		const apply = () => {
			const p = y / Math.max(1, document.documentElement.scrollHeight - innerHeight);
			left.style.setProperty('--y', `${y}px`);
			right.style.setProperty('--y', `${-y}px`);
			for (const rail of [left, right]) rail.style.setProperty('--p', p.toFixed(4));
		};
		const tick = () => {
			const to = scrollY;
			y += (to - y) * EASE;
			if (Math.abs(to - y) < 0.5) y = to;
			apply();
			frame = y === to ? 0 : requestAnimationFrame(tick);
		};
		addEventListener('scroll', () => (frame ||= requestAnimationFrame(tick)), { passive: true });
		for (const rail of [left, right]) rail.toggleAttribute('data-live', true);
		apply();
	}
</script>

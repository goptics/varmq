---
// The home page's opening: the intro beside the whole map, then varmq's story in ten steps, a caption per scroll. Each
// step plays its chapter of the map while the one code block morphs into the code behind it (lib/story/main.ts). The
// title and the lede are the page's hero fields in index.mdx.
import '@shikijs/magic-move/style.css';
import '../lib/heromap/map.css';
import '../styles/story.css';
import Install from './ui/Install.astro';

const { title, tagline } = Astro.locals.starlightRoute.entry.data.hero ?? {};
---

<section class="st" data-at="intro" aria-labelledby="_top">
	<div class="st-track" aria-hidden="true"></div>
	<div class="st-stage">
		<div class="st-text">
			<div class="st-intro">
				<h1 id="_top" tabindex="-1" data-page-title>{title}</h1>
				{tagline && <p class="st-lede" set:html={tagline} />}
				<Install id="home" />
				<div class="st-actions">
					<a class="btn btn--primary" href="/start/quick-start/">Get started</a>
					<a class="btn btn--ghost" href="https://github.com/goptics/varmq">GitHub</a>
				</div>
				<p class="st-hint">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v10M3.5 8 8 12.5 12.5 8"></path></svg>
					Scroll: ten steps, each run on the map beside the code that does it.
				</p>
			</div>
			<div class="st-step" hidden>
				<div>
					<p class="st-count"></p>
					<h2 class="st-title" tabindex="-1"></h2>
				</div>
				<ol class="st-notes"></ol>
				<!-- What a caption button does, and that it has played, for screen readers (main.ts). -->
				<p id="st-does" hidden>Plays this part on the map.</p>
				<p id="st-done" hidden>Played.</p>
				<div class="st-code st-code-wide">
					<pre class="shiki-magic-move-container"></pre>
					<div class="st-rows" aria-hidden="true"></div>
				</div>
				<div class="st-code st-code-phone">
					<pre class="shiki-magic-move-container"></pre>
					<div class="st-rows" aria-hidden="true"></div>
				</div>
				<p class="st-source">Full program: <a></a></p>
			</div>
		</div>
		<div class="st-map">
			<div class="st-frame">
				<varmq-map aria-hidden="true"></varmq-map>
				<!-- Holds the map still, and the hint's arrow; the steps still change, each shown at its end (main.ts). -->
				<button class="pbtn pbtn--paper st-pause" type="button" aria-pressed="false">Pause</button>
			</div>
		</div>
	</div>
	<!-- On steps 1 to 9 only: the way past the rest of the story, to the last step, where the page scrolls freely. Its
	     outline is the story's progress, a segment per step, filled once that step has played (main.ts). -->
	<button class="st-skip" type="button" aria-label="Skip to step 10" disabled>
		<svg class="st-skip-ring" viewBox="0 0 48 48" aria-hidden="true"></svg>
		<svg class="st-skip-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3.5 7.5 8 3 12.5M8.5 3.5 13 8l-4.5 4.5"></path></svg>
	</button>
	<!-- The step the page comes to rest on, said once (main.ts). -->
	<p class="sr-only st-live" aria-live="polite" aria-atomic="true"></p>
	<!-- The whole story as text, for screen readers: the stage only ever shows one step. After the stage, so the h1
	     comes first. -->
	<div class="sr-only st-all"><h2>The story as text</h2></div>
</section>

<script>
	import { copyButtons, tabs } from './ui/dom';
	import '../lib/story/main.ts';

	document.querySelectorAll<HTMLElement>('.st-intro [role="tablist"]').forEach((list) => tabs(list));
	copyButtons();
</script>

---
// The frame every learn scene uses: a dark panel with a title bar, the stage, a caption line that
// shows the Go call, and the controls under the stage. Each scene has a text alternative.
import '../../styles/learn.css';

interface Props {
	id: string;
	title: string;
	tag?: string;
	describe: string;
}
const { id, title, tag = 'simulation', describe } = Astro.props;
---

<figure class="lscene not-content" role="group" aria-labelledby={`${id}-t`} aria-describedby={`${id}-d`} data-scene={id}>
	<div class="lscene__bar">
		<p class="lscene__title" id={`${id}-t`}>{title} <b>· {tag}</b></p>
		<slot name="stats" />
	</div>
	<p class="sr-only" id={`${id}-d`}>{describe}</p>
	<div class="lscene__stage">
		<slot />
	</div>
	<div class="lscene__call">
		<slot name="call" />
	</div>
	<div class="lscene__controls">
		<slot name="controls" />
	</div>
	<slot name="note" />
</figure>

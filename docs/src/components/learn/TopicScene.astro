---
// A topic: one shared log, one cursor per subscribed worker. Mirrors topic.go and internal/topics/log.go:
// Publish appends once and signals every subscribed worker. Each worker reads through its own cursor.
import Scene from './Scene.astro';

interface Props {
	id?: string;
}
const { id = 'topic' } = Astro.props;
---

<Scene
	id={id}
	title="Topic"
	tag="simulation"
	describe="One topic with two subscribed workers. Press Publish to append a payload to the shared log once. Each worker reads the log through its own cursor and makes its own job. Worker B is slower than worker A, and you can pause it. A payload stays in the log until both cursors have moved past it, and a slow or paused worker never holds up Publish or the other worker."
>
	<dl class="lstats" slot="stats">
		<div><dt>published</dt><dd data-stat="pub">0</dd></div>
		<div><dt>in log</dt><dd data-stat="held">0</dd></div>
		<div><dt>A ran</dt><dd data-stat="a">0</dd></div>
		<div><dt>B ran</dt><dd data-stat="b">0</dd></div>
	</dl>

	<div class="tp" data-topic>
		<span class="llabel">shared log</span>
		<ol class="tp__cells" data-cells aria-hidden="true"></ol>
		<div class="tp__workers" aria-hidden="true">
			<div class="tp__w" data-w="a">
				<span class="tp__name"><b>A</b> worker · 0.9 s a job</span>
				<span class="tp__state" data-state></span>
			</div>
			<div class="tp__w" data-w="b">
				<span class="tp__name"><b>B</b> worker · 2.2 s a job</span>
				<span class="tp__state" data-state></span>
			</div>
		</div>
		<p class="estep__text ppool__text" aria-live="polite" data-readout>Press Publish. The payload goes in the log once.</p>
	</div>

	<code class="lcall" slot="call" data-call></code>

	<Fragment slot="controls">
		<button type="button" class="lbtn lbtn--primary" data-act="pub">Publish</button>
		<button type="button" class="lbtn" data-act="pub3">Publish 3</button>
		<button type="button" class="lbtn" data-act="pauseb" aria-pressed="false">Pause B</button>
		<button type="button" class="lbtn" data-act="reset">Reset</button>
	</Fragment>

	<p class="lnote" slot="note">
		A topic is in-memory only. This scene keeps the last 12 payloads. A model of the library, not a benchmark.
	</p>
</Scene>

<script>
	import { setCall } from './ui';

	const SETUP = ['topic := varmq.NewTopic[string]()', 'workerA.WithTopic(topic)', 'workerB.WithTopic(topic)'].join('\n');
	const MAX = 12;

	type W = { key: 'a' | 'b'; ms: number; cursor: number; running: number | null; ran: number; paused: boolean; timer: number | undefined };

	document.querySelectorAll<HTMLElement>('[data-topic]').forEach((root) => {
		const scene = root.closest<HTMLElement>('.lscene')!;
		const q = <T extends HTMLElement>(s: string) => scene.querySelector<T>(s)!;
		const stat = (k: string) => q(`[data-stat="${k}"]`);

		let log: number[] = [];
		let next = 1;
		const mk = (key: 'a' | 'b', ms: number): W => ({ key, ms, cursor: 0, running: null, ran: 0, paused: false, timer: undefined });
		let A = mk('a', 900);
		let B = mk('b', 2200);
		let readout = 'Press Publish. The payload goes in the log once.';

		const pull = (w: W) => {
			if (w.running !== null || w.paused || w.cursor >= log.length) return;
			w.running = log[w.cursor];
			w.cursor++;
			w.timer = window.setTimeout(() => {
				w.ran++;
				w.running = null;
				w.timer = undefined;
				pull(w); // the finished goroutine signals the loop, which pulls the next payload
				readout = describe();
				render();
			}, w.ms);
		};

		const render = () => {
			const released = Math.min(A.cursor, B.cursor);
			const cells = log.map((p, i) => {
				const rel = i < released;
				const dot = (w: W) => `<span class="tdot" data-read="${i < w.cursor}"></span>`;
				return `<li class="tcell" data-released="${rel}"><span class="tcell__p">p${p}</span><span class="tcell__r">${rel ? 'released' : 'kept'}</span><span class="tcell__d"><i>A</i>${dot(A)}</span><span class="tcell__d"><i>B</i>${dot(B)}</span></li>`;
			});
			q('[data-cells]').innerHTML = cells.length ? cells.join('') : '<li class="lempty">empty</li>';

			for (const w of [A, B]) {
				const row = q(`[data-w="${w.key}"]`);
				const text = w.paused && w.running === null ? 'paused' : w.running !== null ? `running p${w.running}` : w.cursor < log.length ? 'about to pull' : 'idle, waiting for a payload';
				row.querySelector('[data-state]')!.textContent = `${text} · cursor at ${w.cursor < log.length ? 'p' + log[w.cursor] : 'the end'}`;
				row.dataset.s = w.running !== null ? 'busy' : w.paused ? 'paused' : 'idle';
			}

			stat('pub').textContent = String(next - 1);
			stat('held').textContent = String(log.length - released);
			stat('a').textContent = String(A.ran);
			stat('b').textContent = String(B.ran);
			q('[data-readout]').textContent = readout;
			const pb = q('[data-act="pauseb"]');
			pb.textContent = B.paused ? 'Resume B' : 'Pause B';
			pb.setAttribute('aria-pressed', String(B.paused));
			const full = next - 1 >= MAX;
			q('[data-act="pub"]').setAttribute('aria-disabled', String(full));
			q('[data-act="pub3"]').setAttribute('aria-disabled', String(full));
		};

		const describe = () => {
			const released = Math.min(A.cursor, B.cursor);
			const held = log.length - released;
			const behind = log.length - B.cursor;
			if (B.paused) return `Worker B is paused. Its cursor stays at ${B.cursor < log.length ? 'p' + log[B.cursor] : 'the end'}, so ${held} payload${held === 1 ? '' : 's'} stay in the log. Publish and worker A are not held up.`;
			if (behind > 1) return `Worker B is ${behind} payloads behind. The log keeps them until B reads them. Worker A already ran ${A.ran}.`;
			return `Both cursors are close. ${released} payload${released === 1 ? ' is' : 's are'} released from the log.`;
		};

		const publish = (count: number) => {
			let last = 0;
			for (let i = 0; i < count && next - 1 < MAX; i++) {
				log.push(next);
				last = next++;
				pull(A);
				pull(B);
			}
			if (!last) return;
			setCall(q('[data-call]'), `ok := topic.Publish("p${last}") // appended once, both workers signalled${count > 1 ? `\n// ×${count} in a row` : ''}`);
			readout = describe();
			render();
		};

		scene.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
			if (!t || t.getAttribute('aria-disabled') === 'true') return;
			switch (t.dataset.act) {
				case 'pub':
					return publish(1);
				case 'pub3':
					return publish(3);
				case 'pauseb':
					B.paused = !B.paused;
					if (B.paused) setCall(q('[data-call]'), 'workerB.Pause() // its running job finishes, then it pulls nothing');
					else {
						setCall(q('[data-call]'), 'workerB.Resume() // it reads on from its cursor');
						pull(B);
					}
					readout = describe();
					return render();
				case 'reset':
					clearTimeout(A.timer);
					clearTimeout(B.timer);
					log = [];
					next = 1;
					A = mk('a', 900);
					B = mk('b', 2200);
					readout = 'Press Publish. The payload goes in the log once.';
					setCall(q('[data-call]'), SETUP);
					return render();
			}
		});

		setCall(q('[data-call]'), SETUP);
		render();
	});
</script>

---
// A topic: one shared log, one cursor per subscribed worker. Mirrors topic.go and internal/topics/log.go:
// Publish appends once and signals every subscribed worker. Each worker reads through its own cursor.
import '../../styles/learn.css';
import Scene from '../ui/Scene.astro';

interface Props {
	id?: string;
}
const { id = 'topic' } = Astro.props;
---

<Scene
	id={id}
	title="Topic"
	tag="simulation"
	class="learn"
	call={"topic := varmq.NewTopic[string]()\nworkerA.WithTopic(topic)\nworkerB.WithTopic(topic)"}
	describe="One topic with two subscribed workers, each with concurrency 1. Press Publish to append a payload to the shared log once. Each worker reads the log through its own cursor and makes its own job. A worker reads only when its goroutine is free, and then takes every unread payload, up to 32, as one batch that it runs in order. Worker B is slower than worker A, and you can pause it: its running job finishes, and the rest of its batch is parked on the worker. A payload stays in the log until both cursors have moved past it, and a slow or paused worker never holds up Publish or the other worker."
>
	<dl class="sframe__stats" slot="stats">
		<div><dt>published</dt><dd data-stat="pub">0</dd></div>
		<div><dt>kept</dt><dd data-stat="held">0</dd></div>
		<div><dt>A ran</dt><dd data-stat="a">0</dd></div>
		<div><dt>B ran</dt><dd data-stat="b">0</dd></div>
	</dl>

	<div class="tp" data-topic>
		<span class="slabel">shared log</span>
		<ol class="tp__cells" data-cells aria-hidden="true"></ol>
		<div class="tp__workers" aria-hidden="true">
			<div class="tp__w" data-w="a">
				<span class="tp__name"><b>A</b> worker · 0.9 s a job</span>
				<span class="tp__state" data-state></span>
			</div>
			<div class="tp__w" data-w="b">
				<span class="tp__name"><b>B</b> worker · 2.2 s a job</span>
				<span class="tp__state" data-state></span>
			</div>
		</div>
		<p class="estep__text ppool__text" aria-live="polite" data-readout>Press Publish. The payload goes in the log once.</p>
	</div>

	<Fragment slot="controls">
		<button type="button" class="pbtn pbtn--primary" data-act="pub">Publish</button>
		<button type="button" class="pbtn" data-act="pub3">Publish 3</button>
		<button type="button" class="pbtn" data-act="pauseb" aria-pressed="false">Pause B</button>
		<button type="button" class="pbtn" data-act="reset">Reset</button>
	</Fragment>

	<p class="sframe__note" slot="note">
		A topic is in-memory only. The log frees memory 1024 payloads at a time, once the slowest cursor has passed them. This scene stops at 12 payloads. A model of the library, not a benchmark.
	</p>
</Scene>

<script>
	import { setCall } from '../ui/dom';

	const SETUP = ['topic := varmq.NewTopic[string]()', 'workerA.WithTopic(topic)', 'workerB.WithTopic(topic)'].join('\n');
	const MAX = 12;

	const MAX_BATCH = 32; // maxBatch in worker_eventloop.go

	/** `batch`: payloads the worker took from the log and has not started; parked while it is paused. */
	type W = { key: 'a' | 'b'; ms: number; cursor: number; running: number | null; batch: number[]; ran: number; paused: boolean; timer: number | undefined };

	document.querySelectorAll<HTMLElement>('[data-topic]').forEach((root) => {
		const scene = root.closest<HTMLElement>('.sframe')!;
		const q = <T extends HTMLElement>(s: string) => scene.querySelector<T>(s)!;
		const stat = (k: string) => q(`[data-stat="${k}"]`);

		let log: number[] = [];
		let next = 1;
		const mk = (key: 'a' | 'b', ms: number): W => ({ key, ms, cursor: 0, running: null, batch: [], ran: 0, paused: false, timer: undefined });
		let A = mk('a', 900);
		let B = mk('b', 2200);
		let readout = 'Press Publish. The payload goes in the log once.';

		// Concurrency 1: a free goroutine takes every unread payload, up to 32, as one batch and runs it
		// in order. While the batch runs the worker reads nothing. A paused worker starts nothing, so the
		// rest of its batch stays parked on it, out of the log.
		const pull = (w: W) => {
			if (w.running !== null || w.paused) return;
			if (!w.batch.length) {
				const end = Math.min(log.length, w.cursor + MAX_BATCH);
				w.batch = log.slice(w.cursor, end);
				w.cursor = end;
			}
			const p = w.batch.shift();
			if (p === undefined) return;
			w.running = p;
			w.timer = window.setTimeout(() => {
				w.ran++;
				w.running = null;
				w.timer = undefined;
				pull(w); // the next job of the batch, or, once the batch ends, a new batch from the cursor
				readout = describe();
				render();
			}, w.ms);
		};

		const render = () => {
			const released = Math.min(A.cursor, B.cursor);
			const cells = log.map((p, i) => {
				const rel = i < released;
				const dot = (w: W) => `<span class="tdot" data-read="${i < w.cursor}"></span>`;
				return `<li class="tcell" data-released="${rel}"><span class="tcell__p">p${p}</span><span class="tcell__r">${rel ? 'read by both' : 'kept'}</span><span class="tcell__d"><i>A</i>${dot(A)}</span><span class="tcell__d"><i>B</i>${dot(B)}</span></li>`;
			});
			q('[data-cells]').innerHTML = cells.length ? cells.join('') : '<li class="lempty">empty</li>';

			for (const w of [A, B]) {
				const row = q(`[data-w="${w.key}"]`);
				const text = w.paused && w.running === null ? 'paused' : w.running !== null ? `running p${w.running}` : 'idle, waiting for a payload';
				const held = w.batch.length ? ` · ${w.paused && w.running === null ? 'parked' : 'batch'} ${w.batch.map((p) => 'p' + p).join(' ')}` : '';
				row.querySelector('[data-state]')!.textContent = `${text}${held} · cursor at ${w.cursor < log.length ? 'p' + log[w.cursor] : 'the end'}`;
				row.dataset.s = w.running !== null ? 'busy' : w.paused ? 'paused' : 'idle';
			}

			stat('pub').textContent = String(next - 1);
			stat('held').textContent = String(log.length - released);
			stat('a').textContent = String(A.ran);
			stat('b').textContent = String(B.ran);
			q('[data-readout]').textContent = readout;
			const pb = q('[data-act="pauseb"]');
			pb.textContent = B.paused ? 'Resume B' : 'Pause B';
			pb.setAttribute('aria-pressed', String(B.paused));
			const full = next - 1 >= MAX;
			q('[data-act="pub"]').setAttribute('aria-disabled', String(full));
			q('[data-act="pub3"]').setAttribute('aria-disabled', String(full));
		};

		const describe = () => {
			const released = Math.min(A.cursor, B.cursor);
			const held = log.length - released;
			const unread = log.length - B.cursor;
			const taken = B.batch.length;
			if (B.paused) {
				const rest = !taken
					? ''
					: B.running !== null
						? ` Its running job finishes, then the ${taken} it had taken ${taken === 1 ? 'waits' : 'wait'}, parked on the worker.`
						: ` ${taken} it had taken ${taken === 1 ? 'waits' : 'wait'}, parked on the worker.`;
				return `Worker B is paused. Its cursor stays at ${B.cursor < log.length ? 'p' + log[B.cursor] : 'the end'}, so ${held} payload${held === 1 ? '' : 's'} stay in the log.${rest} Publish and worker A are not held up.`;
			}
			if (unread > 0) return `Worker B is busy, so it reads nothing. ${unread} payload${unread === 1 ? ' waits' : 's wait'} for its cursor, and the log keeps ${unread === 1 ? 'it' : 'them'}. When its batch ends, B takes ${unread === 1 ? 'it' : 'them all'} as one batch.`;
			if (taken) return `Worker B runs the batch it took from the log, in order: ${taken} more ${taken === 1 ? 'waits' : 'wait'} in it. Its cursor is already at the end.`;
			return `${released} payload${released === 1 ? ' is' : 's are'} read by both cursors. A worker takes what is unread as one batch when it is free.`;
		};

		const publish = (count: number) => {
			let last = 0;
			for (let i = 0; i < count && next - 1 < MAX; i++) {
				log.push(next);
				last = next++;
				pull(A);
				pull(B);
			}
			if (!last) return;
			setCall(q('[data-call]'), `ok := topic.Publish("p${last}") // appended once, both workers signalled${count > 1 ? `\n// ×${count} in a row` : ''}`);
			readout = describe();
			render();
		};

		scene.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
			if (!t || t.getAttribute('aria-disabled') === 'true') return;
			switch (t.dataset.act) {
				case 'pub':
					return publish(1);
				case 'pub3':
					return publish(3);
				case 'pauseb':
					B.paused = !B.paused;
					if (B.paused) setCall(q('[data-call]'), 'workerB.Pause() // its running job finishes; the rest of its batch is parked');
					else {
						setCall(q('[data-call]'), 'workerB.Resume() // parked payloads run first, then it reads on from its cursor');
						pull(B);
					}
					readout = describe();
					return render();
				case 'reset':
					clearTimeout(A.timer);
					clearTimeout(B.timer);
					log = [];
					next = 1;
					A = mk('a', 900);
					B = mk('b', 2200);
					readout = 'Press Publish. The payload goes in the log once.';
					setCall(q('[data-call]'), SETUP);
					return render();
			}
		});

		setCall(q('[data-call]'), SETUP);
		render();
	});
</script>

---
// One worker, one to three queues. Mirrors source_manager.go and internal/helpers/manager.go:
// the strategy picks the queue for every single job, and a tie in priority goes to the queue bound first.
import Scene from './Scene.astro';

interface Props {
	id?: string;
}
const { id = 'bind' } = Astro.props;
---

<Scene
	id={id}
	title="Queues and a worker"
	tag="simulation"
	describe="One worker with a concurrency limit of 2. Bind up to three queues to it, each with three jobs. Pick a strategy: Priority, RoundRobin, MaxLen or MinLen. The scene lists the order in which the worker takes the jobs, two slots at a time, and says which rule chose each queue. A queue can be given a priority number; a lower number goes first, and a tie goes to the queue bound first."
>
	<dl class="lstats" slot="stats">
		<div><dt>queues</dt><dd data-stat="queues">1</dd></div>
		<div><dt>strategy</dt><dd data-stat="strategy">Priority</dd></div>
		<div><dt>limit</dt><dd>2</dd></div>
	</dl>

	<div class="bq" data-bind>
		<div class="bq__queues" data-queues></div>

		<div class="bq__run">
			<span class="llabel">order the worker takes them · 2 slots</span>
			<div data-slots></div>
		</div>

		<p class="estep__text ppool__text" aria-live="polite" data-readout></p>
	</div>

	<code class="lcall" slot="call" data-call></code>

	<Fragment slot="controls">
		<button type="button" class="lbtn lbtn--primary" data-act="bind">Bind another queue</button>
		<button type="button" class="lbtn" data-act="unbind">Remove the last queue</button>
		<span class="lspacer"></span>
		<div class="lgroup">
			<span id={`${id}-sl`}>strategy</span>
			<div class="lseg" role="radiogroup" aria-labelledby={`${id}-sl`} data-strategy>
				<button type="button" role="radio" aria-checked="true" data-v="Priority">Priority</button>
				<button type="button" role="radio" aria-checked="false" tabindex="-1" data-v="RoundRobin">RoundRobin</button>
				<button type="button" role="radio" aria-checked="false" tabindex="-1" data-v="MaxLen">MaxLen</button>
				<button type="button" role="radio" aria-checked="false" tabindex="-1" data-v="MinLen">MinLen</button>
			</div>
		</div>
	</Fragment>

	<p class="lnote" slot="note">
		Every job takes the same time here, so each row of the order is one time step. A model of the library, not a benchmark.
	</p>
</Scene>

<script>
	import { segmented, setCall } from './ui';

	type Strategy = 'Priority' | 'RoundRobin' | 'MaxLen' | 'MinLen';
	type Queue = { name: string; tag: string; priority: number | null; len: number };

	const NAMES = [
		{ name: 'emails', tag: 'e' },
		{ name: 'reports', tag: 'r' },
		{ name: 'backups', tag: 'b' },
	];
	const LIMIT = 2;
	const PER_QUEUE = 3;

	document.querySelectorAll<HTMLElement>('[data-bind]').forEach((root) => {
		const scene = root.closest<HTMLElement>('.lscene')!;
		const q = <T extends HTMLElement>(s: string) => scene.querySelector<T>(s)!;

		let strategy: Strategy = 'Priority';
		let queues: Queue[] = [{ ...NAMES[0], priority: null, len: PER_QUEUE }];

		/** The strategy's choice, as in internal/helpers/manager.go. Returns an index into the list, or -1. */
		const pick = (list: Queue[], order: number[], state: { rr: number }): number => {
			const live = order.filter((i) => list[i].len > 0);
			if (!live.length) return -1;
			switch (strategy) {
				case 'RoundRobin': {
					for (let n = 0; n < order.length; n++) {
						const at = (state.rr + n) % order.length;
						if (list[order[at]].len > 0) {
							state.rr = (at + 1) % order.length;
							return order[at];
						}
					}
					return -1;
				}
				case 'MaxLen':
					return live.reduce((a, b) => (list[b].len > list[a].len ? b : a)); // first of equals wins
				case 'MinLen':
					return live.reduce((a, b) => (list[b].len < list[a].len ? b : a));
				default:
					return live[0]; // the list is sorted by priority, ties in bind order
			}
		};

		const schedule = () => {
			const list = queues.map((x) => ({ ...x }));
			// The manager keeps queues sorted by priority number, ascending; a tie keeps bind order.
			const order = list.map((_, i) => i).sort((a, b) => (list[a].priority ?? Infinity) - (list[b].priority ?? Infinity) || a - b);
			const state = { rr: 0 };
			const taken: { slot: number; t: number; q: number; n: number }[] = [];
			const nextNo = list.map(() => 0);
			let t = 0;
			while (list.some((x) => x.len > 0)) {
				for (let slot = 0; slot < LIMIT; slot++) {
					const i = pick(list, order, state);
					if (i < 0) break;
					list[i].len--;
					taken.push({ slot, t, q: i, n: ++nextNo[i] });
				}
				t++;
			}
			return { taken, rows: t };
		};

		const why = (): string => {
			if (queues.length === 1) return 'One queue is bound. The worker takes its jobs in order, and it may hand a goroutine several at once.';
			const many = 'With more than one queue bound, the worker hands out jobs one at a time, so the strategy picks every single job.';
			switch (strategy) {
				case 'Priority': {
					const tied = queues.every((x) => x.priority === queues[0].priority);
					return `${many} Priority takes the first queue in the list that has a job. The list is sorted by priority number, lowest first. ${tied ? 'No queue has a number here, so they tie and the queue bound first goes first.' : 'A queue without a number comes after every queue that has one.'}`;
				}
				case 'RoundRobin':
					return `${many} RoundRobin takes one job from each queue in turn.`;
				case 'MaxLen':
					return `${many} MaxLen takes from the queue with the most jobs left. A tie goes to the first queue in the list.`;
				default:
					return `${many} MinLen takes from the queue with the fewest jobs left, not counting empty ones.`;
			}
		};

		const render = () => {
			const { taken, rows } = schedule();
			const tagOf = (i: number) => queues[i].tag;
			q('[data-queues]').innerHTML = queues
				.map(
					(x, i) => `<div class="bq__q" data-i="${i}">
						<div class="bq__head"><b>${x.name}</b><span>bound ${['first', 'second', 'third'][i]}</span>
						<label class="bq__prio"><span>priority</span>
						<select data-prio="${i}" aria-label="Priority of ${x.name}"><option value="">none (ties)</option>${[0, 1, 2].map((n) => `<option value="${n}"${x.priority === n ? ' selected' : ''}>${n}</option>`).join('')}</select></label></div>
						<div class="lstrip">${Array.from({ length: PER_QUEUE }, (_, n) => `<span class="ljob ${i === 1 ? 'ljob--b' : i === 2 ? 'ljob--c' : ''}">${x.tag}${n + 1}</span>`).join('')}</div>
					</div>`,
				)
				.join('');
			// keep the select values after innerHTML (selected attr handles it)
			q('[data-slots]').innerHTML = Array.from({ length: rows }, (_, t) => {
				const row = taken.filter((x) => x.t === t);
				return `<div class="llane bq__row"><span class="llane__id">t${t + 1}</span><div class="llane__track">${row
					.map((x) => `<span class="ljob ${x.q === 1 ? 'ljob--b' : x.q === 2 ? 'ljob--c' : ''}" title="slot ${x.slot + 1}">${tagOf(x.q)}${x.n}</span>`)
					.join('')}</div></div>`;
			}).join('');

			q('[data-stat="queues"]').textContent = String(queues.length);
			q('[data-stat="strategy"]').textContent = strategy;
			q('[data-readout]').textContent = why();

			q('[data-act="bind"]').setAttribute('aria-disabled', String(queues.length >= NAMES.length));
			q('[data-act="unbind"]').setAttribute('aria-disabled', String(queues.length <= 1));

			const lines = [`worker := varmq.NewWorker(process, ${LIMIT}${strategy === 'Priority' ? '' : `, varmq.WithStrategy(varmq.${strategy})`})`];
			for (const x of queues) lines.push(`${x.name} := worker.BindQueue(${x.priority === null ? '' : `varmq.WithQueuePriority(${x.priority})`})`);
			setCall(q('[data-call]'), lines.join('\n'));
		};

		scene.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
			if (!t || t.getAttribute('aria-disabled') === 'true') return;
			if (t.dataset.act === 'bind') queues.push({ ...NAMES[queues.length], priority: null, len: PER_QUEUE });
			else if (t.dataset.act === 'unbind') queues.pop();
			render();
		});

		scene.addEventListener('change', (e) => {
			const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-prio]');
			if (!s) return;
			queues[Number(s.dataset.prio)].priority = s.value === '' ? null : Number(s.value);
			render();
			scene.querySelector<HTMLElement>(`[data-prio="${s.dataset.prio}"]`)?.focus();
		});

		segmented(q('[data-strategy]'), (item) => {
			strategy = item.dataset.v as Strategy;
			render();
		});

		render();
	});
</script>

---
// The <varmq-map> element in the home page hero (frontmatter `hero.image.html`). This component draws nothing
// itself: it brings the element's script and its styles to the page. The styles size the element, so its square
// is reserved before the script runs.
---

<script>
	import { CHAPTERS } from '../lib/heromap/chapters.ts';
	import { renderMap, type MapNodes } from '../lib/heromap/render.ts';
	import { REGIONS, frame } from '../lib/heromap/scene.ts';

	const NS = 'http://www.w3.org/2000/svg';
	const TITLE = 'varmq, from one worker to Redis';
	const DESCRIPTION = [
		'An animated map of varmq. A worker takes jobs from a queue, and its pool of goroutines grows while',
		'jobs wait and shrinks after. A result worker hands back values and errors. A priority queue, several',
		'queues with round robin, and a topic feed the worker. A SQLite queue keeps its jobs through a crash,',
		'and a Redis queue is shared by three programs. The worker is paused, resumed, resized and stopped.',
	].join(' ');
	const ICONS = [
		'<svg class="vm-pause" viewBox="0 0 12 12" aria-hidden="true" focusable="false">',
		'<rect x="2.25" y="1.5" width="2.5" height="9" rx=".75"/>',
		'<rect x="7.25" y="1.5" width="2.5" height="9" rx=".75"/></svg>',
		'<svg class="vm-play" viewBox="0 0 12 12" aria-hidden="true" focusable="false">',
		'<path d="M3 1.6v8.8L10.4 6z"/></svg>',
	].join('');

	/** A caption line: `*word*` green and `!word!` red, as `Caption` in chapters.ts marks them. */
	function line(text: string): HTMLElement {
		const span = document.createElement('span');
		// The marked parts are the split's odd entries.
		text.split(/(\*[^*]+\*|![^!]+!)/).forEach((part, i) => {
			if (i % 2 === 0) {
				span.append(part);
				return;
			}
			const word = document.createElement(part[0] === '*' ? 'em' : 'b');
			word.textContent = part.slice(1, -1);
			span.append(word);
		});
		return span;
	}

	class VarmqMap extends HTMLElement {
		/** The drawn map. Public, so a review can move the camera from the console. */
		nodes?: MapNodes;
		/** Paused with the button. */
		userPaused = false;
		button!: HTMLButtonElement;

		connectedCallback() {
			if (this.nodes) return; // moved within the page: it is drawn already
			const nodes = renderMap(this);
			this.nodes = nodes;
			this.describe(nodes);
			this.addButton();

			// The still finale frame: the whole map with every piece on, and the finale's first caption.
			nodes.setCamera(frame(REGIONS[REGIONS.length - 1]));
			nodes.caption.replaceChildren(line(CHAPTERS[CHAPTERS.length - 1].captions[0].text));
		}

		/** One image to assistive technology, with a name and a description, and none of the map's own text. */
		describe({ svg, world }: MapNodes) {
			const title = document.createElementNS(NS, 'title');
			title.id = 'vm-title';
			title.textContent = TITLE;
			const desc = document.createElementNS(NS, 'desc');
			desc.id = 'vm-desc';
			desc.textContent = DESCRIPTION;
			svg.prepend(title, desc);
			svg.setAttribute('role', 'img');
			svg.setAttribute('aria-labelledby', title.id);
			svg.setAttribute('aria-describedby', desc.id);
			// Chrome keeps an SVG image's text in the accessibility tree, so the labels would be read one by one.
			world.setAttribute('aria-hidden', 'true');
		}

		addButton() {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'vm-toggle';
			button.innerHTML = ICONS;
			button.addEventListener('click', () => this.setUserPaused(!this.userPaused));
			this.button = button;
			this.setUserPaused(false);
			this.append(button);
		}

		setUserPaused(paused: boolean) {
			this.userPaused = paused;
			this.button.dataset.state = paused ? 'paused' : 'playing';
			this.button.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
		}
	}

	if (!customElements.get('varmq-map')) customElements.define('varmq-map', VarmqMap);
</script>

<style is:global>
	/* Style A · Glow. Dark is the default; the light palette keeps the hues in darker ink, with no glow. */
	varmq-map {
		--vm-bg-1: #101a26;
		--vm-bg-2: #06080c;
		--vm-frame: rgba(150, 175, 200, 0.14);
		--vm-dot: #1e2a38;
		--vm-ink: #8592a3;
		--vm-caption: #cfd8e3;
		--vm-green: #44bf9e;
		--vm-red: #ff6b6b;
		--vm-glow: url(#vm-glow);
		--vm-job: #f2b33d;
		--vm-job-edge: #f2b33d;
		--vm-job-ink: #3a2a00;
		--vm-chip: #1e201f;
		--vm-chip-edge: rgba(242, 179, 61, 0.65);
		--vm-chip-ink: #f2b33d;
		--vm-value: #102126;
		--vm-value-edge: rgba(68, 191, 158, 0.65);
		--vm-error: #1f1a22;
		--vm-error-edge: rgba(255, 107, 107, 0.65);
		--vm-lane: rgba(242, 179, 61, 0.05);
		--vm-lane-edge: #f2b33d;
		--vm-lane-tail: 0.12;
		--vm-lane-head: 0.9;
		--vm-tray: rgba(242, 179, 61, 0.02);
		--vm-tray-edge: rgba(242, 179, 61, 0.35);
		--vm-slot: rgba(242, 179, 61, 0.18);
		--vm-go: #44bf9e;
		--vm-go-fill: rgba(68, 191, 158, 0.1);
		--vm-ghost: rgba(68, 191, 158, 0.3);
		--vm-check: #d6fff0;
		--vm-card: rgba(68, 191, 158, 0.04);
		--vm-card-edge: rgba(68, 191, 158, 0.45);
		--vm-loop: #8b5cf6;
		--vm-loop-fill: rgba(139, 92, 246, 0.1);
		--vm-pulse: #a78bfa;
		--vm-store: rgba(139, 92, 246, 0.05);
		--vm-store-edge: rgba(139, 92, 246, 0.6);
		--vm-program: rgba(150, 175, 200, 0.03);
		--vm-program-edge: rgba(150, 175, 200, 0.4);
		--vm-line: rgba(150, 175, 200, 0.35);
		--vm-notify: rgba(167, 139, 250, 0.35);
		--vm-ack: rgba(68, 191, 158, 0.3);
		--vm-button: rgba(6, 8, 12, 0.6);
		--vm-button-edge: rgba(150, 175, 200, 0.3);

		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid var(--vm-frame);
		border-radius: 14px;
		background: radial-gradient(120% 90% at 50% 35%, var(--vm-bg-1) 0%, var(--vm-bg-2) 72%);
		container-type: inline-size;
	}

	:root[data-theme='light'] varmq-map {
		--vm-bg-1: #f7fafc;
		--vm-bg-2: #e9eef4;
		--vm-frame: rgba(71, 85, 105, 0.2);
		--vm-dot: #cfd8e3;
		--vm-ink: #4b5563;
		--vm-caption: #1f2937;
		--vm-green: #0f7a5c;
		--vm-red: #c62828;
		--vm-glow: none;
		--vm-job: #e09b0c;
		--vm-job-edge: #b7791f;
		--vm-chip: #fcf5e7;
		--vm-chip-edge: rgba(183, 121, 31, 0.7);
		--vm-chip-ink: #8f5a0b;
		--vm-value: #eaf5f2;
		--vm-value-edge: rgba(46, 156, 127, 0.7);
		--vm-error: #faeeee;
		--vm-error-edge: rgba(198, 40, 40, 0.6);
		--vm-lane: rgba(224, 155, 12, 0.07);
		--vm-lane-edge: #b7791f;
		--vm-lane-tail: 0.3;
		--vm-lane-head: 1;
		--vm-tray: rgba(224, 155, 12, 0.03);
		--vm-tray-edge: rgba(183, 121, 31, 0.6);
		--vm-slot: rgba(183, 121, 31, 0.35);
		--vm-go: #2e9c7f;
		--vm-go-fill: rgba(46, 156, 127, 0.12);
		--vm-ghost: rgba(46, 156, 127, 0.45);
		--vm-check: #0f7a5c;
		--vm-card: rgba(46, 156, 127, 0.06);
		--vm-card-edge: rgba(46, 156, 127, 0.6);
		--vm-loop: #7c3aed;
		--vm-loop-fill: rgba(124, 58, 237, 0.08);
		--vm-pulse: #7c3aed;
		--vm-store: rgba(124, 58, 237, 0.05);
		--vm-store-edge: rgba(124, 58, 237, 0.6);
		--vm-program: rgba(71, 85, 105, 0.03);
		--vm-program-edge: rgba(71, 85, 105, 0.45);
		--vm-line: rgba(71, 85, 105, 0.45);
		--vm-notify: rgba(124, 58, 237, 0.45);
		--vm-ack: rgba(46, 156, 127, 0.55);
		--vm-button: rgba(255, 255, 255, 0.75);
		--vm-button-edge: rgba(71, 85, 105, 0.3);
	}

	varmq-map .vm-svg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	varmq-map :is(.vm-go, .vm-job, .vm-record, .vm-chip, .vm-pulse, .vm-flash) {
		transform-box: fill-box;
		transform-origin: center;
	}

	varmq-map .vm-dot {
		fill: var(--vm-dot);
	}

	varmq-map .vm-edge-tail {
		stop-color: var(--vm-lane-edge);
		stop-opacity: var(--vm-lane-tail);
	}

	varmq-map .vm-edge-head {
		stop-color: var(--vm-lane-edge);
		stop-opacity: var(--vm-lane-head);
	}

	/* Text hides while it would be too small to read (--vm-label, from the camera). Its opacity is left free. */
	varmq-map :is(.vm-label, .vm-text, .vm-num) {
		font-family: var(--__sl-font-mono);
		font-weight: 600;
		fill-opacity: var(--vm-label, 1);
	}

	varmq-map .vm-label {
		font-size: 14px;
		letter-spacing: 0.14em;
		fill: var(--vm-ink);
	}

	varmq-map .vm-label.vm-died {
		fill: var(--vm-red);
	}

	varmq-map .vm-text {
		font-size: 13px;
		fill: var(--vm-chip-ink);
	}

	varmq-map .vm-num {
		font-size: 13px;
		font-weight: 700;
		fill: var(--vm-job-ink);
	}

	varmq-map .vm-program > .vm-shape {
		fill: var(--vm-program);
		stroke: var(--vm-program-edge);
		stroke-width: 1;
	}

	varmq-map .vm-store > .vm-shape {
		fill: var(--vm-store);
		stroke: var(--vm-store-edge);
		stroke-width: 1.2;
	}

	varmq-map .vm-lane > .vm-shape {
		fill: var(--vm-lane);
		stroke: url(#vm-lane-edge);
		stroke-width: 1.2;
	}

	varmq-map .vm-tray > .vm-shape {
		fill: var(--vm-tray);
		stroke: var(--vm-tray-edge);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}

	varmq-map .vm-slot {
		fill: none;
		stroke: var(--vm-slot);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}

	varmq-map .vm-card > .vm-shape {
		fill: var(--vm-card);
		stroke: var(--vm-card-edge);
		stroke-width: 1;
	}

	varmq-map .vm-loop > .vm-shape {
		fill: var(--vm-loop-fill);
		stroke: var(--vm-loop);
		stroke-width: 1.4;
		filter: var(--vm-glow);
	}

	varmq-map .vm-pulse {
		fill: none;
		stroke: var(--vm-pulse);
		stroke-width: 1.4;
	}

	/* Chips are opaque: the RoundRobin chip sits on the line into the loop. */
	varmq-map .vm-chip > .vm-shape {
		fill: var(--vm-chip);
		stroke: var(--vm-chip-edge);
		stroke-width: 1;
	}

	varmq-map .vm-value > .vm-shape {
		fill: var(--vm-value);
		stroke: var(--vm-value-edge);
	}

	varmq-map .vm-value > .vm-text {
		fill: var(--vm-green);
	}

	varmq-map .vm-error > .vm-shape {
		fill: var(--vm-error);
		stroke: var(--vm-error-edge);
	}

	varmq-map .vm-error > .vm-text {
		fill: var(--vm-red);
	}

	varmq-map .vm-flash {
		fill: none;
		stroke: var(--vm-red);
		stroke-width: 2;
	}

	varmq-map .vm-conn > .vm-shape {
		fill: none;
		stroke: var(--vm-line);
		stroke-width: 1;
	}

	varmq-map .vm-notify > .vm-shape {
		stroke: var(--vm-notify);
		stroke-dasharray: 2 3;
	}

	varmq-map .vm-ack > .vm-shape {
		stroke: var(--vm-ack);
		stroke-dasharray: 2 3;
	}

	varmq-map .vm-ghost {
		fill: none;
		stroke: var(--vm-ghost);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}

	varmq-map .vm-ring {
		fill: var(--vm-go-fill);
		stroke: var(--vm-go);
		stroke-width: 1.4;
		filter: var(--vm-glow);
	}

	varmq-map .vm-progress {
		fill: none;
		stroke: var(--vm-go);
		stroke-width: 2;
		stroke-linecap: round;
	}

	varmq-map .vm-check {
		fill: none;
		stroke: var(--vm-check);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* A job's edge matches its fill in the dark, so an in-flight record is its fill-opacity alone. */
	varmq-map .vm-jb {
		fill: var(--vm-job);
		stroke: var(--vm-job-edge);
		stroke-width: 1.4;
	}

	varmq-map :is(.vm-main, .vm-record) > .vm-jb {
		filter: var(--vm-glow);
	}

	varmq-map .vm-t1 > .vm-jb {
		opacity: 0.35;
	}

	varmq-map .vm-t2 > .vm-jb {
		opacity: 0.15;
	}

	/* The caption band: the bottom 56 of the square's 400, below the map. Captions are 10.5 of the 400. */
	varmq-map .vm-caption {
		position: absolute;
		inset: auto 0 0;
		height: 14%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(to bottom, transparent, var(--vm-bg-2) 60%);
		color: var(--vm-caption);
		font-family: var(--__sl-font-mono);
		font-size: calc(100cqw * 10.5 / 400);
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
		white-space: nowrap;
		pointer-events: none;
	}

	varmq-map .vm-caption em {
		font-style: normal;
		color: var(--vm-green);
	}

	varmq-map .vm-caption b {
		font-weight: inherit;
		color: var(--vm-red);
	}

	varmq-map .vm-toggle {
		position: absolute;
		top: 8px;
		right: 8px;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 1px solid var(--vm-button-edge);
		border-radius: 50%;
		background: var(--vm-button);
		color: var(--vm-ink);
		cursor: pointer;
	}

	varmq-map .vm-toggle:hover {
		border-color: var(--vm-ink);
		color: var(--vm-caption);
	}

	varmq-map .vm-toggle:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	varmq-map .vm-toggle svg {
		width: 12px;
		height: 12px;
		fill: currentColor;
	}

	varmq-map .vm-toggle[data-state='playing'] .vm-play,
	varmq-map .vm-toggle[data-state='paused'] .vm-pause {
		display: none;
	}

	/* On a phone the square would push the title and Get started down: leave it out. */
	@media (width < 50rem) {
		.hero > .hero-html:has(> varmq-map) {
			display: none;
		}
	}
</style>

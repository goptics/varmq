---
import { highlightGo } from './go-highlight';

const sources = import.meta.glob<string>('../../../examples/*/main.go', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const tabs = [
	{
		key: 'priority',
		label: 'Priority',
		example: 'queues-priority',
		text: 'The worker starts after the three jobs are added, so the lowest number runs first.',
		href: '/guides/queues/',
	},
	{
		key: 'rr',
		label: 'Round robin',
		example: 'strategies-round-robin',
		text: 'One worker takes jobs from three queues in turn.',
		href: '/guides/strategies/',
	},
	{
		key: 'topics',
		label: 'Topics',
		example: 'topic-subscribe',
		text: 'Two workers subscribe to one topic, and each gets every order.',
		href: '/guides/topics/',
	},
	{
		key: 'results',
		label: 'Results',
		example: 'worker-types-result',
		text: 'A result worker returns a value and an error, which you read from the job.',
		href: '/guides/worker-types/',
	},
].map((t) => {
	const src = sources[`../../../examples/${t.example}/main.go`];
	if (src === undefined) throw new Error(`Examples: unknown example "${t.example}"`);
	return { ...t, src };
});
---

<div class="ex" data-tabs>
	<div class="seg" role="tablist" aria-label="Example programs">
		{
			tabs.map((t, i) => (
				<button
					type="button"
					role="tab"
					id={`ex-tab-${t.key}`}
					aria-controls={`ex-panel-${t.key}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-key={t.key}
				>
					{t.label}
				</button>
			))
		}
	</div>
	{
		tabs.map((t, i) => (
			<div role="tabpanel" id={`ex-panel-${t.key}`} aria-labelledby={`ex-tab-${t.key}`} hidden={i !== 0} class="ex">
				<p class="ex__more">{t.text}</p>
				<div class="code">
					<div class="code__head">
						<span>{t.example}/main.go</span>
						<a href={t.href}>Run it in the docs</a>
					</div>
					<pre class="gocode"><code set:html={highlightGo(t.src)} /></pre>
				</div>
			</div>
		))
	}
</div>

---
import { highlightGo } from '../ui/go';

const lanes = Array.from({ length: 6 }, (_, i) => i);
const waiting = Array.from({ length: 9 }, (_, i) => i + 1);
const dots = Array.from({ length: 48 }, (_, i) => i);

const code = `worker := varmq.NewWorker(process, varmq.WithConcurrency(3))
queue := worker.BindQueue()

queue.Add(job) // returns at once, the job waits for a free worker`;
---

<section class="pool" data-pool aria-labelledby="pool-title">
	<div class="pool__bar">
		<h2 class="pool__title" id="pool-title">Live pool <b>· simulation</b></h2>
		<dl class="pool__stats">
			<div><dt>state</dt><dd data-stat="state">running</dd></div>
			<div><dt>workers</dt><dd data-stat="workers">3</dd></div>
			<div><dt>waiting</dt><dd data-stat="waiting">9</dd></div>
			<div><dt>done</dt><dd data-stat="done">0</dd></div>
		</dl>
	</div>

	<div class="pool__stage" aria-hidden="true">
		<div class="pool__col pool__col--queue">
			<span class="pool__label">queue</span>
			<div class="pool__jobs" data-queue>
				{waiting.map((n) => <span class={n === 1 ? 'job is-next' : 'job'}>{n}</span>)}
			</div>
		</div>
		<div class="pool__col pool__col--lanes">
			<span class="pool__label">workers</span>
			{
				lanes.map((i) => (
					<div class="lane" data-lane data-off={i >= 3 ? '' : undefined}>
						<span class="lane__id">w{i + 1}</span>
						<div class="lane__track">
							<span class="lane__fill" />
							<span class="job lane__job" />
						</div>
					</div>
				))
			}
		</div>
		<div class="pool__col pool__col--out">
			<span class="pool__label">done</span>
			<div class="pool__dots" data-dots>
				{dots.map(() => <i />)}
			</div>
			<p class="pool__tally" data-tally>0 done</p>
		</div>
	</div>

	<div class="pool__controls">
		<button type="button" class="pbtn pbtn--primary" data-act="add">Add job</button>
		<button type="button" class="pbtn" data-act="burst">Add 10</button>
		<div class="stepper" role="group" aria-label="Workers">
			<button type="button" class="pbtn" data-act="fewer" aria-label="Remove a worker">−</button>
			<output><span data-stat="workers">3</span> workers</output>
			<button type="button" class="pbtn" data-act="more" aria-label="Add a worker">+</button>
		</div>
		<button type="button" class="pbtn" data-act="toggle">Pause</button>
		<button type="button" class="pbtn" data-act="producer" aria-pressed="true">Producer: on</button>
		<span class="pool__note">Simulation. It draws the model. It is not a benchmark.</span>
	</div>

	<div class="pool__code">
		<pre class="gocode"><code set:html={highlightGo(code)} /></pre>
		<code class="call" data-call>// press a button: the call it makes shows here</code>
	</div>
	<p class="sr-only" role="status" data-live></p>
</section>

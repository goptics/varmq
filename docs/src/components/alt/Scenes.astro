---
import { finalFrame } from './scene-data';

interface Chip {
	k: string;
	label: string;
	tone?: 'amber' | 'cobalt';
}
interface Scene {
	key: 'priority' | 'strategy' | 'topic';
	title: string;
	text: string;
	href: string;
	more: string;
	chips: Chip[];
	slots: { c: number; r: number; label: string; w?: boolean }[];
}

const scenes: Scene[] = [
	{
		key: 'priority',
		title: 'Priority queues',
		text: 'Give a job a number. The lowest number runs first, and equal numbers keep the order you added them.',
		href: '/guides/queues/',
		more: 'Queues',
		chips: [
			{ k: 'r', label: 'report 10' },
			{ k: 'a', label: 'alert 1', tone: 'amber' },
			{ k: 'd', label: 'digest 10' },
		],
		slots: [{ c: 0, r: 2, label: 'worker' }],
	},
	{
		key: 'strategy',
		title: 'Several queues, one worker',
		text: 'Bind many queues to one worker. A strategy decides which queue gives the next job: Priority, RoundRobin, MaxLen or MinLen.',
		href: '/guides/strategies/',
		more: 'Strategies',
		chips: [
			{ k: 'a1', label: 'alert 1', tone: 'amber' },
			{ k: 'a2', label: 'alert 2', tone: 'amber' },
			{ k: 'r1', label: 'report 1', tone: 'cobalt' },
			{ k: 'e1', label: 'email 1' },
			{ k: 'e2', label: 'email 2' },
			{ k: 'e3', label: 'email 3' },
		],
		slots: [{ c: 3, r: 1, label: 'worker', w: true }],
	},
	{
		key: 'topic',
		title: 'Topics',
		text: 'Publish once and every subscribed worker gets its own job. A queue gives each job to one worker.',
		href: '/guides/topics/',
		more: 'Topics',
		chips: [
			{ k: 'p', label: 'order 7' },
			{ k: 'e', label: 'order 7', tone: 'amber' },
			{ k: 's', label: 'order 7', tone: 'cobalt' },
		],
		slots: [
			{ c: 0, r: 1, label: 'topic' },
			{ c: 3, r: 0, label: 'email' },
			{ c: 3, r: 2, label: 'stock' },
		],
	},
];
---

<div class="scenes">
	{
		scenes.map((s) => {
			const last = finalFrame(s.key);
			return (
				<article class="scene-card">
					<p class="scene-cap" data-cap aria-hidden="true">{last.cap}</p>
					<div class="scene" data-scene={s.key} role="img" aria-label={`${s.title}: ${s.text}`}>
						<div class="scene__field">
							{s.slots.map((sl) => (
								<span class="slot" style={`--c:${sl.c};--r:${sl.r}`} data-w={sl.w ? '' : undefined}>
									{sl.label}
								</span>
							))}
							{s.chips.map((c) => {
								const cell = last.chips[c.k];
								const [col, row, o, state = ''] = cell;
								const [kind, n] = state.split(':');
								const cls = [
									'chip',
									c.tone ? `chip--${c.tone}` : '',
									kind === 'dim' ? 'is-dim' : '',
									kind === 'run' ? 'is-run' : '',
									kind === 'next' ? 'is-next' : '',
								]
									.filter(Boolean)
									.join(' ');
								return (
									<span class={cls} data-k={c.k} data-n={n} style={`--c:${col};--r:${row};--o:${o}`}>
										{c.label}
									</span>
								);
							})}
						</div>
					</div>
					<h3 class="h3">{s.title}</h3>
					<p>{s.text}</p>
					<p><a href={s.href}>{s.more} guide</a></p>
				</article>
			);
		})
	}
</div>

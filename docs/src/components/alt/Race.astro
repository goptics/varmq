---
// Every figure below comes from the raw output in github.com/goptics/benchmarks
// (pool/bench, redis/bench, sqlite/bench), run of 2026-10-25, varmq v1.10.0.
// Pool figures are the mean over the 15 rows at 50K workers (3 tasks x 5 producer shapes)
// and over GOMAXPROCS 24, 8 and 4. Memory is the benchmark's B/op for the same rows.

interface Lane {
	name: string;
	v: number;
	varmq?: boolean;
}

const lanes = (list: Lane[], base: number, opts: { dec?: number; suffix?: string; div?: number } = {}) => {
	const { dec = 0, suffix = '', div = 1 } = opts;
	const max = Math.max(...list.map((l) => l.v));
	return list.map((l) => ({
		name: l.name,
		varmq: l.varmq,
		s: (l.v / max).toFixed(4),
		v: l.v / div,
		dec,
		suffix,
		text: (l.v / div).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suffix,
		x: (l.v / base).toFixed(2) + '×',
	}));
};

const poolRate = lanes(
	[
		{ name: 'VarMQ', v: 4892786, varmq: true },
		{ name: 'Buffered channel †', v: 2726882 },
		{ name: 'errgroup', v: 2293891 },
		{ name: 'ants', v: 2216056 },
		{ name: 'gopool', v: 1917047 },
		{ name: 'Channel †', v: 1900040 },
		{ name: 'conc', v: 1560073 },
		{ name: 'workerpool', v: 1348902 },
		{ name: 'pond', v: 601828 },
	],
	4892786,
	{ dec: 2, suffix: 'M', div: 1e6 },
);

const poolMem = lanes(
	[
		{ name: 'Channel †', v: 14.5 },
		{ name: 'conc', v: 15.0 },
		{ name: 'ants', v: 15.4 },
		{ name: 'Buffered channel †', v: 23.2 },
		{ name: 'workerpool', v: 28.2 },
		{ name: 'gopool', v: 52.0 },
		{ name: 'errgroup', v: 110.7 },
		{ name: 'VarMQ', v: 115.0, varmq: true },
		{ name: 'pond', v: 317.8 },
	],
	115.0,
	{ dec: 1, suffix: ' MB' },
);

const redisMany = lanes(
	[
		{ name: 'VarMQ', v: 59898, varmq: true },
		{ name: 'gocraft/work', v: 44775 },
		{ name: 'taskq', v: 34499 },
		{ name: 'rmq', v: 28521 },
		{ name: 'Asynq', v: 17744 },
	],
	59898,
);
const redisOne = lanes(
	[
		{ name: 'rmq', v: 35708 },
		{ name: 'gocraft/work', v: 25731 },
		{ name: 'VarMQ', v: 20812, varmq: true },
		{ name: 'taskq', v: 18448 },
		{ name: 'Asynq', v: 15096 },
	],
	20812,
);

const sqlite = lanes(
	[
		{ name: 'VarMQ', v: 14725, varmq: true },
		{ name: 'River', v: 3230 },
		{ name: 'goqite', v: 2933 },
		{ name: 'backlite', v: 1119 },
	],
	14725,
);
---

<div class="race on-dark" data-race>
	<section class="section" id="benchmarks" aria-labelledby="bench-title">
		<div class="wrap">
			<div class="banner"><span class="banner__id">JOB 04</span><span>Measured in public</span><span class="banner__rule"></span><span class="banner__meta">raw output published</span></div>
			<div class="section__head">
				<h2 class="h2" id="bench-title">The numbers, and where they do not favor VarMQ.</h2>
				<p>
					Each lane is one library on the same harness, same machine and same run. The longest bar is the highest value.
					The last column is the lane's value divided by VarMQ's.
				</p>
			</div>

			<div data-tabs>
				<div class="race__top">
					<div class="seg" role="tablist" aria-label="Benchmark suite">
						<button type="button" role="tab" id="race-tab-pool" aria-controls="race-panel-pool" aria-selected="true" data-key="pool">Worker pool</button>
						<button type="button" role="tab" id="race-tab-redis" aria-controls="race-panel-redis" aria-selected="false" tabindex="-1" data-key="redis">Redis queues</button>
						<button type="button" role="tab" id="race-tab-sqlite" aria-controls="race-panel-sqlite" aria-selected="false" tabindex="-1" data-key="sqlite">SQLite queues</button>
					</div>
					<button type="button" class="pbtn" data-replay>Replay</button>
				</div>

				<div role="tabpanel" id="race-panel-pool" aria-labelledby="race-tab-pool" data-panel>
					<p class="race__spec">
						Mean tasks per second over 15 rows: 3 task types × 5 producer shapes (1 to 1,000,000 producers),
						50K workers, 1M tasks per run. Averaged over GOMAXPROCS 24, 8 and 4.
						Memory is bytes allocated per run of 1M tasks, from the same rows.
					</p>
					<div class="race__groups">
						<div>
							<div class="rg__title"><h3>Throughput</h3><span>tasks per second · higher is better</span></div>
							<div class="rlane__head" aria-hidden="true"><span>Library</span><span></span><span>Rate</span><span>× VarMQ</span></div>
							<ol class="rlanes">
								{
									poolRate.map((l) => (
										<li class:list={['rlane', { 'is-varmq': l.varmq }]}>
											<span class="rlane__name">{l.name}</span>
											<span class="rlane__track" aria-hidden="true"><span class="rlane__bar" style={`--s:${l.s}`} /></span>
											<span class="rlane__val" data-v={l.v} data-dec={l.dec} data-suffix={l.suffix}>{l.text}</span>
											<span class="rlane__x">{l.x}</span>
										</li>
									))
								}
							</ol>
						</div>
						<div>
							<div class="rg__title"><h3>Memory</h3><span>MB allocated per 1M tasks · lower is better</span></div>
							<div class="rlane__head" aria-hidden="true"><span>Library</span><span></span><span>Allocated</span><span>× VarMQ</span></div>
							<ol class="rlanes">
								{
									poolMem.map((l) => (
										<li class:list={['rlane', { 'is-varmq': l.varmq }]}>
											<span class="rlane__name">{l.name}</span>
											<span class="rlane__track" aria-hidden="true"><span class="rlane__bar" style={`--s:${l.s}`} /></span>
											<span class="rlane__val" data-v={l.v} data-dec={l.dec} data-suffix={l.suffix}>{l.text}</span>
											<span class="rlane__x">{l.x}</span>
										</li>
									))
								}
							</ol>
						</div>
					</div>
					<p class="race__foot" style="margin-top:20px">
						† Baselines, not libraries: N goroutines reading one channel. The buffered one has a channel that holds all 1M tasks.
					</p>
				</div>

				<div role="tabpanel" id="race-panel-redis" aria-labelledby="race-tab-redis" data-panel hidden>
					<p class="race__spec">
						100,000 no-op jobs through one library instance with 100 workers, Redis 7.2 on one pinned core.
						VarMQ runs on redisq. Median time from enqueue to handler, one job at a time: VarMQ 0.058 ms, the lowest of the run.
						taskq 0.062 ms, gocraft/work 0.082 ms, rmq 1.25 ms, Asynq 998 ms.
					</p>
					<div data-tabs>
						<div class="seg" role="tablist" aria-label="Producers" style="margin-bottom:24px">
							<button type="button" role="tab" id="redis-tab-many" aria-controls="redis-panel-many" aria-selected="true" data-key="many">100 producers</button>
							<button type="button" role="tab" id="redis-tab-one" aria-controls="redis-panel-one" aria-selected="false" tabindex="-1" data-key="one">1 producer</button>
						</div>
						<div class="race__groups race__groups--one" role="tabpanel" id="redis-panel-many" aria-labelledby="redis-tab-many" data-subpanel>
							<div>
								<div class="rg__title"><h3>100 producers enqueue at once</h3><span>jobs per second · higher is better</span></div>
								<div class="rlane__head" aria-hidden="true"><span>Library</span><span></span><span>Rate</span><span>× VarMQ</span></div>
								<ol class="rlanes">
									{
										redisMany.map((l) => (
											<li class:list={['rlane', { 'is-varmq': l.varmq }]}>
												<span class="rlane__name">{l.name}</span>
												<span class="rlane__track" aria-hidden="true"><span class="rlane__bar" style={`--s:${l.s}`} /></span>
												<span class="rlane__val" data-v={l.v} data-dec={l.dec} data-suffix={l.suffix}>{l.text}</span>
												<span class="rlane__x">{l.x}</span>
											</li>
										))
									}
								</ol>
							</div>
						</div>
						<div class="race__groups race__groups--one" role="tabpanel" id="redis-panel-one" aria-labelledby="redis-tab-one" data-subpanel hidden>
							<div>
								<div class="rg__title"><h3>One producer enqueues 100,000 jobs</h3><span>jobs per second · higher is better</span></div>
								<div class="rlane__head" aria-hidden="true"><span>Library</span><span></span><span>Rate</span><span>× VarMQ</span></div>
								<ol class="rlanes">
									{
										redisOne.map((l) => (
											<li class:list={['rlane', { 'is-varmq': l.varmq }]}>
												<span class="rlane__name">{l.name}</span>
												<span class="rlane__track" aria-hidden="true"><span class="rlane__bar" style={`--s:${l.s}`} /></span>
												<span class="rlane__val" data-v={l.v} data-dec={l.dec} data-suffix={l.suffix}>{l.text}</span>
												<span class="rlane__x">{l.x}</span>
											</li>
										))
									}
								</ol>
							</div>
						</div>
					</div>
				</div>

				<div role="tabpanel" id="race-panel-sqlite" aria-labelledby="race-tab-sqlite" data-panel hidden>
					<p class="race__spec">
						Drain 20,000 jobs added by 4 producers, WAL checkpoint every 1,000 pages. VarMQ runs on sqliteq.
						In this run VarMQ was the fastest subject in all 8 scenario and checkpoint groups.
					</p>
					<div class="race__groups race__groups--one">
						<div>
							<div class="rg__title"><h3>Drain one queue</h3><span>jobs per second · higher is better</span></div>
							<div class="rlane__head" aria-hidden="true"><span>Library</span><span></span><span>Rate</span><span>× VarMQ</span></div>
							<ol class="rlanes">
								{
									sqlite.map((l) => (
										<li class:list={['rlane', { 'is-varmq': l.varmq }]}>
											<span class="rlane__name">{l.name}</span>
											<span class="rlane__track" aria-hidden="true"><span class="rlane__bar" style={`--s:${l.s}`} /></span>
											<span class="rlane__val" data-v={l.v} data-dec={l.dec} data-suffix={l.suffix}>{l.text}</span>
											<span class="rlane__x">{l.x}</span>
										</li>
									))
								}
							</ol>
						</div>
					</div>
				</div>
			</div>

			<div class="race__trade">
				<h3>What the same run says against VarMQ</h3>
				<ul>
					<li>
						<strong>Memory.</strong> VarMQ allocates 115 MB per 1M tasks. ants allocates 15 MB, which is 7.5× less.{' '}
						<code>Add</code> never blocks, so waiting tasks sit in an unbounded queue.
					</li>
					<li><strong>One worker.</strong> On the 15 one-worker <code>Loop10</code> rows, a plain buffered channel is fastest in all 15.</li>
					<li><strong>4 CPUs.</strong> The buffered channel wins 21 of 55 rows and VarMQ wins 19. At 24 CPUs VarMQ wins 39 and the channel 12.</li>
					<li><strong>Redis, one producer.</strong> rmq leads every single-producer row. VarMQ leads when 100 producers enqueue, at 100 and 1,000 workers.</li>
				</ul>
			</div>

			<p class="race__foot">
				Run of 2026-10-25 · varmq v1.10.0 · Intel Core i7-13700 (24 threads), linux/amd64, Go 1.26 · Absolute numbers vary between
				runs, so compare ratios within one run. Figures come from the raw output in
				<a href="https://github.com/goptics/benchmarks">github.com/goptics/benchmarks</a>;
				charts and the harness are at <a href="https://benchmarks.goptics.org">benchmarks.goptics.org</a>.
			</p>
		</div>
	</section>
</div>

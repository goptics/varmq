---
import '../../styles/guides-a.css';
import Scene from '../ui/Scene.astro';

const describe =
	'A queue whose worker, with concurrency 1, has not started. Add a job with the ID refresh, then add another job with the same ID: the second Add returns nil and false, because a job with that ID is still in the queue. AddAll prefixes the ID with g:, so an AddAll item with the ID refresh does not collide. An AddAll item that repeats an ID is skipped, and the group it returns has NumPending 0. Two jobs with no ID are both stored, and a generated ID is not checked. Start the worker: it takes every waiting job, up to 32, into one batch, so the queue frees all their IDs and the same IDs can be used again while the jobs run. While the batch runs, new jobs wait in the queue and hold their IDs. Purge removes the waiting jobs and frees their IDs, and closes the jobs of the batch that have not started.';

const ids = [
	['', 'no ID'],
	['refresh', 'refresh'],
	['sync', 'sync'],
];
---

<Scene id="job-id-dedup" title="Job IDs" call={'queue.Add("job 1", varmq.WithJobId("refresh"))'} describe={describe} class="ga">
	<div class="ga-cols ga-cols--2">
		<section class="ga-panel" aria-label="The queue">
			<p class="ga-label">
				<strong>In the queue</strong>
				<span class="ga-tag" data-gen>no generator</span>
			</p>
			<div class="ga-rail" role="list" aria-label="Jobs waiting in the queue" data-queue>
				<span class="ga-hint" aria-hidden="true">empty</span>
			</div>
			<div class="lane">
				<span class="lane__id">worker</span>
				<div class="lane__track" role="list" aria-label="Running job" data-run>
					<span class="ga-hint" aria-hidden="true">not started</span>
				</div>
			</div>
			<p class="ga-label">
				<strong>Taken into a batch</strong><span>not in the queue, ID free</span>
			</p>
			<div class="ga-rail ga-rail--ghost" role="list" aria-label="Jobs the worker took into a batch" data-batch>
				<span class="ga-hint" aria-hidden="true">none</span>
			</div>
			<p class="ga-label">
				<strong>IDs the queue holds</strong><span>a repeat of these is refused</span>
			</p>
			<div class="ga-rail ga-rail--ghost" role="list" aria-label="IDs held by the queue" data-held>
				<span class="ga-hint" aria-hidden="true">none</span>
			</div>
		</section>

		<section class="ga-panel" aria-label="The calls and what they returned">
			<p class="ga-label"><strong>Calls, newest first</strong></p>
			<ul class="ga-log" data-log>
				<li class="ga-hint">no calls yet</li>
			</ul>
			<p class="ga-note ga-why" data-why></p>
		</section>
	</div>

	<Fragment slot="controls">
		<div class="seg" role="radiogroup" aria-label="The ID to give the job" data-ids>
			{
				ids.map(([key, label], i) => (
					<button type="button" role="radio" data-key={key} aria-checked={i === 1 ? 'true' : 'false'} tabindex={i === 1 ? 0 : -1}>
						{label}
					</button>
				))
			}
		</div>
		<div class="seg" role="radiogroup" aria-label="The call" data-via>
			<button type="button" role="radio" data-key="Add" aria-checked="true" tabindex="0">Add</button>
			<button type="button" role="radio" data-key="AddAll" aria-checked="false" tabindex="-1">AddAll</button>
		</div>
		<button type="button" class="pbtn pbtn--primary" data-add>Add job</button>
		<button type="button" class="pbtn" data-gen-toggle aria-pressed="false">Generator</button>
		<span class="sframe__spacer"></span>
		<button type="button" class="pbtn" data-start>Start worker</button>
		<button type="button" class="pbtn" data-purge>Purge()</button>
		<button type="button" class="pbtn" data-reset>Reset</button>
	</Fragment>
</Scene>

<script>
	import './job-id-dedup';
</script>

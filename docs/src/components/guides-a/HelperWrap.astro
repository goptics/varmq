---
import '../../styles/guides-a.css';
import Scene from '../ui/Scene.astro';

const describe =
	'What each function helper wraps. Func, ErrFunc and ResultFunc each return a ready-made worker function. The worker function reads the job data, which is your closure, and calls it. If the closure is nil, Func panics, and the worker recovers the panic and reports it on Errs. ErrFunc returns an error, which Err returns. ResultFunc returns the zero value and an error, which Result returns. Pick a helper and a closure to see which lines of the helper run.';

const helpers = [
	['func', 'Func()'],
	['err', 'ErrFunc()'],
	['result', 'ResultFunc[string]()'],
];
const closures = [
	['works', 'a closure that works'],
	['fails', 'a closure that fails'],
	['nil', 'nil'],
];
---

<Scene id="helper-wrap" title="Function helpers" call={'queue := varmq.NewWorker(varmq.Func(), 1).BindQueue()'} describe={describe} class="ga">
	<div class="ga-stack">
		<div class="ga-toolbar">
			<div class="seg" role="tablist" aria-label="Helper">
				{
					helpers.map(([key, name], i) => (
						<button
							type="button"
							role="tab"
							id={`ga-fh-tab-${key}`}
							data-key={key}
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls="ga-fh-panel"
							tabindex={i === 0 ? 0 : -1}
						>
							{name}
						</button>
					))
				}
			</div>
			<div class="seg" role="radiogroup" aria-label="The closure you add">
				{
					closures.map(([key, label], i) => (
						<button type="button" role="radio" data-key={key} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
							{label}
						</button>
					))
				}
			</div>
		</div>

		<div role="tabpanel" id="ga-fh-panel" aria-labelledby="ga-fh-tab-func" class="ga-cols ga-cols--2" data-panel>
			<div class="ga-stack">
				<section class="ga-panel" data-step="1" aria-label="What you add">
					<h3>1. You add a closure. It becomes the job data.</h3>
					<pre class="ga-code"><code data-add-code></code></pre>
				</section>
				<section class="ga-panel" data-step="3" aria-label="What you get">
					<h3>3. What you get</h3>
					<dl class="ga-read ga-read--stack">
						<dt>Add returns</dt>
						<dd data-type></dd>
						<dt data-read-k></dt>
						<dd data-read></dd>
						<dt><code>Errs()</code></dt>
						<dd data-errs></dd>
					</dl>
					<p class="ga-note" data-why></p>
				</section>
			</div>
			<section class="ga-panel" data-step="2" aria-label="The worker function the helper returns">
				<h3>2. The worker function the helper returns</h3>
				<pre class="ga-code"><code data-code></code></pre>
				<p class="ga-note" data-line-note></p>
			</section>
		</div>
	</div>

	<Fragment slot="controls">
		<button type="button" class="pbtn pbtn--primary" data-add>Add the closure</button>
	</Fragment>
</Scene>

<script>
	import './helper-wrap';
</script>

---
// The scene frame: a dark panel with a caption line that shows the Go call, the scene, and the
// controls under it. Each scene fills the default slot (the stage) and the `controls` slot.
import '../../styles/guides-a.css';
import { highlightGo } from './kit';

interface Props {
	/** The id of the scene, also the value of `data-ga`. */
	scene: string;
	/** A short accessible name. */
	label: string;
	/** The Go line shown before the reader does anything. */
	cap: string;
	/** What the scene shows, for readers who cannot see it. */
	alt: string;
}

const { scene, label, cap, alt } = Astro.props;
const altId = `ga-alt-${scene}`;
---

<figure class="ga ga-frame not-content" data-ga={scene} role="group" aria-label={label} aria-describedby={altId}>
	<figcaption class="ga-cap">
		<span class="ga-cap__tag">Go</span>
		<code data-cap set:html={highlightGo(cap)} />
	</figcaption>
	<div class="ga-stage">
		<slot />
	</div>
	<div class="ga-controls" role="group" aria-label="Controls">
		<slot name="controls" />
	</div>
	<p class="ga-sr" id={altId}>{alt}</p>
	<p class="ga-sr" aria-live="polite" data-live></p>
</figure>

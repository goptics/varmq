---
// The home page's closing: a tear line, then the install box and the way in. The footer's own tear line is hidden on
// the home page (home.css), so there is one.
import '../../styles/home.css';
import Install from '../ui/Install.astro';
---

<section class="home-row section wrap" aria-labelledby="close-title" style="padding-top:0">
	<p class="tear" aria-hidden="true">tear here</p>
	<div class="close">
		<h2 class="h-display h1" id="close-title">Run your first worker.</h2>
		<Install id="close" />
		<div class="close__actions">
			<a class="btn btn--primary" href="/start/quick-start/">Quick start</a>
			<a class="btn btn--ghost" href="/start/introduction/">Read the docs</a>
		</div>
	</div>
</section>

<script>
	import './ui.ts';
</script>

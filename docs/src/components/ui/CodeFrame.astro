---
// The frame of the docs' fenced blocks (the MDX `pre`, pages/[...slug].astro). A dark panel in both themes, with the
// file name in a tab when there is one, and a Copy button.
interface Props {
	title?: string;
	[attr: string]: unknown;
}
const { title, class: cls, style: _style, icon: _icon, ...rest } = Astro.props;
---

<figure class:list={['codeblock', 'not-content not-prose', { 'has-title': !!title }]}>
	{
		title && (
			<figcaption class="codeblock__head">
				<span class="codeblock__title">{title}</span>
			</figcaption>
		)
	}
	<pre class={cls as string} {...rest}><slot /></pre>
	<button type="button" class="codeblock__copy" aria-label="Copy code" data-codecopy>Copy</button>
</figure>

<script>
	import { copyText } from './dom';

	// One listener for every code block on the page. Copies the code without the collapsed lines' summaries.
	document.addEventListener('click', (e) => {
		const button = (e.target as Element).closest<HTMLButtonElement>('[data-codecopy]');
		const code = button?.closest('.codeblock')?.querySelector('code');
		if (!button || !code) return;
		const copy = code.cloneNode(true) as HTMLElement;
		copy.querySelectorAll('summary').forEach((s) => s.remove());
		void copyText(button, copy.textContent ?? '');
	});
</script>

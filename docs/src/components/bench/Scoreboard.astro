---
// Who leads how many groups, for every dataset. The counts come from data.json through lib.ts. Nothing is typed by hand.
import '../../styles/tokens.css';
import '../../styles/bench.css';
import raw from './data.json';
import { currentMetric, defaultState, laneSet, lossCounts, lossesOf, label, scopeOf, viewById } from './lib.ts';
import type { Data, Filters, State } from './lib.ts';

const data = raw as unknown as Data;

// [view, label, filters that replace the defaults, metric]. "all" instances reads the C1 and C4 groups together.
const ROWS: [string, string, Filters, string][] = [
	['pool-all', 'Pool, 24 + 8 + 4 CPUs', {}, 'rate'],
	['pool-all', 'Pool, 24 + 8 + 4 CPUs', {}, 'memory'],
	['pool-24cpu', 'Pool, 24 CPUs', {}, 'rate'],
	['pool-24cpu', 'Pool, 24 CPUs', {}, 'memory'],
	['pool-8cpu', 'Pool, 8 CPUs', {}, 'rate'],
	['pool-8cpu', 'Pool, 8 CPUs', {}, 'memory'],
	['pool-4cpu', 'Pool, 4 CPUs', {}, 'rate'],
	['pool-4cpu', 'Pool, 4 CPUs', {}, 'memory'],
	['redis', 'Redis, drain 100K jobs', { test: 'durable', instances: 'all' }, 'rate'],
	['redis', 'Redis, drain 100K jobs', { test: 'durable', instances: 'all' }, 'memory'],
	['redis', 'Redis, enqueue only', { test: 'enqueue' }, 'rate'],
	['redis', 'Redis, enqueue only', { test: 'enqueue' }, 'memory'],
	['redis', 'Redis, latency', { test: 'latency' }, 'p50'],
	['sqlite', 'SQLite, all scenarios', {}, 'rate'],
	['sqlite', 'SQLite, all scenarios', {}, 'wal'],
];

const rows = ROWS.map(([id, name, f, metric]) => {
	const base = defaultState(data, id);
	const state: State = { ...base, f: { ...base.f, ...f } };
	const m = currentMetric({ ...state, metric });
	const cells = scopeOf(data, state);
	const set = laneSet(cells, m, state);
	const losses = lossesOf(cells, m, state);
	return {
		name,
		metric: m.id === 'rate' ? 'Throughput' : m.id === 'memory' ? 'Memory' : m.id === 'wal' ? 'WAL size' : 'Median latency',
		groups: set.groups,
		varmq: set.wins.varmq,
		other: set.wins.other,
		rivals: lossCounts(losses).slice(0, 3),
		share: set.groups ? (100 * set.wins.varmq) / set.groups : 0,
	};
});
---

<div class="bboard not-content" data-pagefind-ignore>
	<div class="bboard__head">
		<p>
			A group is one case that every subject runs, for example <code>Sleep10ms</code> with 50K workers and one producer. A subject leads a group when it has the highest throughput, or the
			lowest memory, WAL size or latency. VarMQ leads when any VarMQ subject does. The counts come from the rows in the data file.
		</p>
	</div>
	<div class="btable">
		<table class="btable__t">
			<caption class="sr">Groups led by VarMQ and by another subject, for each dataset and metric</caption>
			<thead>
				<tr>
					<th scope="col">Dataset</th>
					<th scope="col">Metric</th>
					<th scope="col">VarMQ leads</th>
					<th scope="col">Another leads</th>
					<th scope="col">Most often ahead of VarMQ</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr>
							<th scope="row" style="min-width:0;white-space:normal">{r.name}</th>
							<td style="text-align:left">{r.metric}</td>
							<td class="n">
								<strong>{r.varmq.toLocaleString('en-US')}</strong> of {r.groups.toLocaleString('en-US')}
								<span class="bshare" style={`--w:${r.share.toFixed(1)}%`} aria-hidden="true" />
							</td>
							<td class={['n', r.other ? 'bamber' : ''].join(' ')}>{r.other.toLocaleString('en-US')}</td>
							<td style="text-align:left;white-space:normal">
								{r.rivals.length ? r.rivals.map((x, i) => (
									<>
										{i > 0 && ', '}
										{label(x.subject)} {x.n}
									</>
								)) : 'none'}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</div>

---
import { Code } from '@astrojs/starlight/components';
import { pins } from '../lib/playground';
import goMod from '../../examples/go.mod?raw';

interface Props {
	example: string;
	title?: string;
}

const sources = import.meta.glob<string>('../../examples/*/main.go', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const { example, title = `${example}/main.go` } = Astro.props;
const src = sources[`../../examples/${example}/main.go`];
if (src === undefined) throw new Error(`GoPlay: unknown example "${example}"`);
---

<go-play class="not-content" data-pins={JSON.stringify(pins(goMod))}>
	<div data-read>
		<Code code={src} lang="go" title={title} />
	</div>
	<textarea
		data-editor
		hidden
		rows={src.split('\n').length}
		spellcheck="false"
		autocomplete="off"
		autocapitalize="off"
		wrap="off"
		aria-label={`Edit ${title}`}>{src}</textarea
	>
	<div class="actions">
		<button type="button" data-run class="primary">Run</button>
		<button type="button" data-edit>Edit</button>
		<button type="button" data-reset hidden>Reset</button>
		<button type="button" data-open>Open in Go Playground</button>
	</div>
	<pre data-output aria-live="polite" hidden></pre>
</go-play>

<script>
	import { compile, replay, requestBody, share, type OutKind, type Pins } from '../lib/playground';

	const RUNNING = 'Running… (first run of an edited example can take ~15 s)';
	const UNREACHABLE = "Couldn't reach the Go Playground. Try again, or open it there.";
	const SHARE_FAILED = "Couldn't reach the Go Playground to share this code. Try again.";
	const TIMEOUT_MS = 60_000;

	class GoPlay extends HTMLElement {
		pins!: Pins;
		read!: HTMLElement;
		editor!: HTMLTextAreaElement;
		runBtn!: HTMLButtonElement;
		editBtn!: HTMLButtonElement;
		resetBtn!: HTMLButtonElement;
		out!: HTMLPreElement;

		connectedCallback() {
			this.pins = JSON.parse(this.dataset.pins!);
			this.read = this.querySelector('[data-read]')!;
			this.editor = this.querySelector('[data-editor]')!;
			this.runBtn = this.querySelector('[data-run]')!;
			this.editBtn = this.querySelector('[data-edit]')!;
			this.resetBtn = this.querySelector('[data-reset]')!;
			this.out = this.querySelector('[data-output]')!;

			this.runBtn.addEventListener('click', () => this.run());
			this.editBtn.addEventListener('click', () => this.edit());
			this.resetBtn.addEventListener('click', () => this.reset());
			this.querySelector('[data-open]')!.addEventListener('click', () => this.open());
			this.editor.addEventListener('keydown', (e) => this.onKey(e));
		}

		/** The request body for whatever the reader sees now: the original or their edit. */
		body() {
			return requestBody(this.editor.value, this.pins);
		}

		edit() {
			this.read.hidden = true;
			this.editor.hidden = false;
			this.editBtn.hidden = true;
			this.resetBtn.hidden = false;
			this.editor.focus();
		}

		reset() {
			this.editor.value = this.editor.defaultValue;
			this.editor.hidden = true;
			this.read.hidden = false;
			this.resetBtn.hidden = true;
			this.editBtn.hidden = false;
		}

		onKey(e: KeyboardEvent) {
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				this.run();
			} else if (e.key === 'Tab' && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
				e.preventDefault();
				// execCommand keeps the browser's undo history; setRangeText is the fallback.
				if (!document.execCommand('insertText', false, '\t')) {
					const { selectionStart: s, selectionEnd: end } = this.editor;
					this.editor.setRangeText('\t', s, end, 'end');
				}
			}
		}

		write(text: string, kind: OutKind) {
			const span = document.createElement('span');
			span.className = kind;
			span.textContent = text;
			this.out.append(span);
		}

		async run() {
			if (this.runBtn.disabled) return;
			this.runBtn.disabled = true;
			this.runBtn.textContent = 'Running…';
			this.out.hidden = false;
			this.out.replaceChildren();
			this.write(RUNNING, 'system');

			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS);
			try {
				const res = await compile(this.body(), fetch, ctl.signal);
				this.out.replaceChildren();
				await replay(
					res,
					(text, kind) => this.write(text, kind),
					(ms) => new Promise((r) => setTimeout(r, ms)),
				);
			} catch {
				this.out.replaceChildren();
				this.write(UNREACHABLE + '\n', 'error');
				const link = document.createElement('button');
				link.type = 'button';
				link.className = 'link';
				link.textContent = 'Open in Go Playground';
				link.addEventListener('click', () => this.open());
				this.out.append(link);
			} finally {
				clearTimeout(timer);
				this.runBtn.disabled = false;
				this.runBtn.textContent = 'Run';
			}
		}

		async open() {
			// Open the tab now, inside the click: a window.open after an await gets popup-blocked.
			const tab = window.open('', '_blank');
			if (tab) tab.opener = null;
			try {
				const url = await share(this.body());
				if (tab) tab.location.href = url;
				else window.location.href = url;
			} catch {
				tab?.close();
				this.out.hidden = false;
				if (!this.runBtn.disabled) this.out.replaceChildren(); // don't wipe a run in progress
				this.write(SHARE_FAILED + '\n', 'error');
			}
		}
	}

	if (!customElements.get('go-play')) customElements.define('go-play', GoPlay);
</script>

<style>
	go-play {
		display: block;
		margin-block: 1.5rem;
	}

	go-play [hidden] {
		display: none !important;
	}

	textarea {
		box-sizing: border-box;
		display: block;
		width: 100%;
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-code);
		line-height: var(--sl-line-height);
		tab-size: 2;
		white-space: pre;
		overflow-x: auto;
		resize: vertical;
	}

	textarea:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -1px;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	button {
		cursor: pointer;
		padding: 0.375rem 0.875rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		line-height: 1.25;
	}

	button:hover {
		border-color: var(--sl-color-gray-3);
	}

	button.primary {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
	}

	button:disabled {
		cursor: progress;
		opacity: 0.6;
	}

	pre {
		margin: 0.75rem 0 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-code);
		line-height: var(--sl-line-height);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	/* Output lines are created at runtime, so they carry no scope attribute. */
	pre :global(.stderr),
	pre :global(.error) {
		color: var(--sl-color-red-high);
	}

	pre :global(.system) {
		color: var(--sl-color-gray-3);
	}

	pre :global(button.link) {
		cursor: pointer;
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font: inherit;
		text-decoration: underline;
	}
</style>

---
import { Code } from '@astrojs/starlight/components';
import { pins } from '../lib/playground';
import goMod from '../../examples/go.mod?raw';

interface Props {
	example: string;
	title?: string;
	/** Shows only main's body and the Run button, as the home page's intro does. */
	compact?: boolean;
}

const sources = import.meta.glob<string>('../../examples/*/main.go', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const { example, title = `${example}/main.go`, compact = false } = Astro.props;
const src = sources[`../../examples/${example}/main.go`];
if (src === undefined) throw new Error(`GoPlay: unknown example "${example}"`);
const hintId = `go-play-hint-${example}`;

// Collapse the package clause and imports, and `func main() {` when nothing else comes
// before it, so the block opens on the code that matters. Run and Edit use the full source.
const lines = src.split('\n');
let head = lines.findIndex((l, i) => i > 0 && l !== '' && !/^(import|package|\t|\))/.test(l));
if (lines[head] === 'func main() {') head++;
const meta = head > 0 ? `collapse={1-${head}}` : '';
// Compact, the block shows main's body alone, a tab less deep. Run still sends the full source.
const shown = compact ? lines.slice(head, lines.lastIndexOf('}')).map((l) => l.replace(/^\t/, '')).join('\n') : src;
---

<go-play class="not-content" data-pins={JSON.stringify(pins(goMod))} data-compact={compact || undefined}>
	<div data-read>
		<Code code={shown} lang="go" title={title} meta={compact ? '' : meta} />
	</div>
	<textarea
		data-editor
		hidden
		rows={src.split('\n').length}
		spellcheck="false"
		autocomplete="off"
		autocapitalize="off"
		wrap="off"
		aria-label={`Edit ${title}`}
		aria-describedby={hintId}>{src}</textarea
	>
	<p class="hint" id={hintId}>Tab inserts a tab. Esc leaves the editor. Ctrl+Enter runs.</p>
	<div class="actions">
		{compact && <button type="button" data-code class="pbtn">Code</button>}
		<button type="button" data-run class="pbtn pbtn--primary">Run</button>
		<button type="button" data-edit class="pbtn pbtn--paper" hidden={compact}>Edit</button>
		<button type="button" data-reset hidden class="pbtn pbtn--paper">Reset</button>
		<button type="button" data-open class="pbtn pbtn--paper" hidden={compact}>Open in Go Playground</button>
	</div>
	<pre data-output aria-live="polite"></pre>
</go-play>

<script>
	import { compile, replay, requestBody, share, type OutKind, type Pins } from '../lib/playground';

	const RUNNING = 'Running… (first run of an example can take ~15 s)';
	const UNREACHABLE = "Couldn't reach the Go Playground. Try again, or open it there.";
	const SHARE_FAILED = "Couldn't reach the Go Playground to share this code. Try again.";
	const POPUP_BLOCKED = 'The browser blocked the new tab. Open this code in the Go Playground: ';
	const TIMEOUT_MS = 60_000;

	class GoPlay extends HTMLElement {
		pins!: Pins;
		read!: HTMLElement;
		editor!: HTMLTextAreaElement;
		runBtn!: HTMLButtonElement;
		editBtn!: HTMLButtonElement;
		resetBtn!: HTMLButtonElement;
		out!: HTMLPreElement;
		running = false;

		connectedCallback() {
			this.pins = JSON.parse(this.dataset.pins!);
			this.read = this.querySelector('[data-read]')!;
			this.editor = this.querySelector('[data-editor]')!;
			this.runBtn = this.querySelector('[data-run]')!;
			this.editBtn = this.querySelector('[data-edit]')!;
			this.resetBtn = this.querySelector('[data-reset]')!;
			this.out = this.querySelector('[data-output]')!;

			this.runBtn.addEventListener('click', () => this.run());
			this.editBtn.addEventListener('click', () => this.edit());
			this.resetBtn.addEventListener('click', () => this.reset());
			this.querySelector('[data-open]')!.addEventListener('click', () => this.open());
			// Compact, the output covers the code; Code clears it to show the code again.
			this.querySelector('[data-code]')?.addEventListener('click', () => {
				this.out.replaceChildren();
				this.runBtn.focus();
			});
			this.editor.addEventListener('keydown', (e) => this.onKey(e));
		}

		/** The request body for whatever the reader sees now: the original or their edit. */
		body() {
			return requestBody(this.editor.value, this.pins);
		}

		edit() {
			this.read.hidden = true;
			this.editor.hidden = false;
			this.editBtn.hidden = true;
			this.resetBtn.hidden = false;
			this.editor.focus();
		}

		reset() {
			this.editor.value = this.editor.defaultValue;
			this.editor.hidden = true;
			this.read.hidden = false;
			this.resetBtn.hidden = true;
			this.editBtn.hidden = false;
			this.editBtn.focus(); // Reset just hid itself; don't leave focus on nothing.
		}

		onKey(e: KeyboardEvent) {
			if (e.isComposing) return; // the keys belong to the input method
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				this.run();
			} else if (e.key === 'Escape') {
				// Tab is taken for indenting, so Esc is the keyboard way out to the buttons.
				this.runBtn.focus();
			} else if (e.key === 'Tab' && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
				e.preventDefault();
				// execCommand keeps the browser's undo history; setRangeText is the fallback.
				if (!document.execCommand('insertText', false, '\t')) {
					const { selectionStart: s, selectionEnd: end } = this.editor;
					this.editor.setRangeText('\t', s, end, 'end');
				}
			}
		}

		write(text: string, kind: OutKind) {
			const span = document.createElement('span');
			span.className = kind;
			span.textContent = text;
			this.out.append(span);
			// Where the output box is short (compact), keep its newest line in view.
			this.out.scrollTop = this.out.scrollHeight;
		}

		async run() {
			if (this.running) return;
			// aria-disabled, not disabled: a disabled button drops keyboard focus.
			this.running = true;
			this.runBtn.setAttribute('aria-disabled', 'true');
			this.runBtn.textContent = 'Running…';
			this.out.replaceChildren();
			this.write(RUNNING, 'system');

			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS);
			try {
				const res = await compile(this.body(), fetch, ctl.signal);
				// Clear on the first write, not now: replay may wait before it, and an
				// empty output collapses (pre:empty), which would make the box jump.
				let first = true;
				await replay(
					res,
					(text, kind) => {
						if (first) this.out.replaceChildren();
						first = false;
						this.write(text, kind);
					},
					(ms) => new Promise((r) => setTimeout(r, ms)),
				);
			} catch {
				this.out.replaceChildren();
				this.write(UNREACHABLE + '\n', 'error');
				const link = document.createElement('button');
				link.type = 'button';
				link.className = 'link';
				link.textContent = 'Open in Go Playground';
				link.addEventListener('click', () => this.open());
				this.out.append(link);
			} finally {
				clearTimeout(timer);
				this.running = false;
				this.runBtn.removeAttribute('aria-disabled');
				this.runBtn.textContent = 'Run';
			}
		}

		async open() {
			// Open the tab now, inside the click: a window.open after an await gets popup-blocked.
			const tab = window.open('', '_blank');
			if (tab) tab.opener = null;
			try {
				const url = await share(this.body());
				if (tab) {
					tab.location.href = url;
					return;
				}
				// Popup blocked. Leaving this page would lose an edit, so offer a link instead.
				if (!this.running) this.out.replaceChildren(); // don't wipe a run in progress
				this.write(POPUP_BLOCKED, 'system');
				const link = document.createElement('a');
				link.className = 'link';
				link.href = url;
				link.target = '_blank';
				link.rel = 'noopener';
				link.textContent = url;
				this.out.append(link, '\n');
			} catch {
				tab?.close();
				if (!this.running) this.out.replaceChildren(); // don't wipe a run in progress
				this.write(SHARE_FAILED + '\n', 'error');
			}
		}
	}

	if (!customElements.get('go-play')) customElements.define('go-play', GoPlay);
</script>

<style>
	go-play {
		display: block;
		margin-block: 1.5rem;
	}

	go-play [hidden] {
		display: none !important;
	}

	textarea {
		box-sizing: border-box;
		display: block;
		width: 100%;
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-code);
		line-height: var(--sl-line-height);
		tab-size: 2;
		white-space: pre;
		overflow-x: auto;
		resize: vertical;
	}

	textarea:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -1px;
	}

	.hint {
		margin: 0.375rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	textarea[hidden] + .hint {
		display: none;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.pbtn[aria-disabled='true'] {
		cursor: progress;
		opacity: 0.6;
	}

	pre {
		margin: 0.75rem 0 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-code);
		line-height: var(--sl-line-height);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	/* Empty until the first run, but still rendered, so the live region is in the
	   accessibility tree before its first announcement. */
	pre:empty {
		margin: 0;
		padding: 0;
		border: 0;
	}

	/* Compact: Run sits in the code's title bar, and the output covers the code below it, the same size, so nothing
	   around it moves. Code shows only once there is output to leave. */
	go-play[data-compact] {
		position: relative;
	}

	go-play[data-compact] .actions {
		position: absolute;
		top: 0;
		right: 0;
		margin: 0;
		padding: 3px;
		z-index: 2;
		gap: 4px;
	}

	go-play[data-compact] .pbtn {
		min-height: 0;
		padding: 4px 12px;
		font-size: 0.75rem;
	}

	go-play[data-compact]:has(pre:empty) [data-code] {
		display: none;
	}

	go-play[data-compact] pre:not(:empty) {
		position: absolute;
		inset: var(--go-play-bar, 2rem) 0 0;
		margin: 0;
		border-radius: 0 0 0.5rem 0.5rem;
		background: var(--panel);
		overflow-y: auto;
		z-index: 1;
	}

	/* Output lines are created at runtime, so they carry no scope attribute. */
	pre :global(.stderr),
	pre :global(.error) {
		color: var(--sl-color-red-high);
	}

	pre :global(.system) {
		color: var(--sl-color-gray-3);
	}

	pre :global(button.link),
	pre :global(a.link) {
		cursor: pointer;
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font: inherit;
		text-decoration: underline;
	}
</style>
